<UserControl x:Class="UCaldas.Granjas.App.Vistas.Remisiones.ReciboCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Etiq" TargetType="TextBlock" BasedOn="{StaticResource Texto.Etiqueta}">
      <Setter Property="Margin" Value="0,0,10,8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Cel" TargetType="TextBlock">
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,18,26,20">
      <!-- Encabezado y consecutivo -->
      <Border Background="{StaticResource Brush.Primario}" CornerRadius="6" Padding="15,10" Margin="0,0,0,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Fecha:" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
            <DatePicker Width="130" SelectedDate="{Binding Fecha, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <Border DockPanel.Dock="Right" Background="{StaticResource Brush.Arena}" CornerRadius="4" Padding="12,4" Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock FontWeight="Medium" FontSize="15" Foreground="{StaticResource Brush.Texto}">
              <Run Text="Recibo No: " /><Run Text="{Binding Contexto.NumeroRecibo, Mode=OneWay}" />
            </TextBlock>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="RECIBO DE CAJA — FACULTAD DE CIENCIAS AGROPECUARIAS" Foreground="White" FontSize="14" FontWeight="Medium" />
            <TextBlock Text="Universidad de Caldas — Sistema Granja" Foreground="White" FontSize="11.5" Opacity="0.85" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Datos de la remisión y del pagador -->
      <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Remisión:" Style="{StaticResource Etiq}" />
          <TextBlock Grid.Column="1" Margin="0,0,0,8" FontWeight="Medium" VerticalAlignment="Center">
            <Run Text="{Binding Contexto.NumeroRemision, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Contexto.Programa, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Grid.Row="1" Text="Recibí de:" Style="{StaticResource Etiq}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Contexto.Comprador}" Margin="0,0,0,8" FontWeight="Medium" VerticalAlignment="Center"
                     Visibility="{Binding PideComprador, Converter={StaticResource InvertirVisibilidad}}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8"
                      Visibility="{Binding PideComprador, Converter={StaticResource BoolAVisibilidad}}">
            <RadioButton GroupName="Comprador" Content="Convenio" IsChecked="{Binding EsConvenio}" Margin="0,0,8,0" VerticalContentAlignment="Center" />
            <ComboBox Width="190" ItemsSource="{Binding Convenios}" SelectedItem="{Binding Convenio}" DisplayMemberPath="Nombre" Margin="0,0,20,0" />
            <RadioButton GroupName="Comprador" Content="Otro comprador" IsChecked="{Binding EsOtro}" Margin="0,0,8,0" VerticalContentAlignment="Center" />
            <ComboBox Width="190" ItemsSource="{Binding Clientes}" SelectedItem="{Binding Cliente}" DisplayMemberPath="NombreRazonSocial" />
          </StackPanel>
          <TextBlock Grid.Row="2" Text="La suma de:" Style="{StaticResource Etiq}" />
          <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" Text="{Binding TotalLetras, Mode=OneWay}" FontWeight="Medium" Background="{StaticResource Brush.Deshabilitado}" />
        </Grid>
      </Border>

      <!-- Detalle heredado de la remisión -->
      <Border Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,0,12">
        <DataGrid ItemsSource="{Binding Lineas}" MaxHeight="170" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="Auto" MinWidth="90" />
            <DataGridTextColumn Header="Detalle" Binding="{Binding Descripcion}" Width="*" MinWidth="200" />
            <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="Auto" MinWidth="70" />
            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat='#,##0.##'}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource Celda.Derecha}" />
            <DataGridTextColumn Header="Valor total" Binding="{Binding ValorTotal, StringFormat='$#,##0'}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource Celda.Derecha}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Forma de pago y totales -->
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="Forma de pago" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,8" />
            <TextBlock Text="Traslado interno entre granjas: el valor es el contable (o $0)." Style="{StaticResource Texto.Suave}" TextWrapping="Wrap"
                       Visibility="{Binding EsTraslado, Converter={StaticResource BoolAVisibilidad}}" />
            <StackPanel Visibility="{Binding EsVenta, Converter={StaticResource BoolAVisibilidad}}">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton GroupName="Pago" Content="Consignación bancaria" IsChecked="{Binding EsConsignacion}" Margin="0,0,18,0" />
                <RadioButton GroupName="Pago" Content="Cheque - Efectivo" IsChecked="{Binding EsEfectivoCheque}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding MostrarBanco, Converter={StaticResource BoolAVisibilidad}}">
                <TextBlock Text="Entidad bancaria:" Style="{StaticResource Etiq}" Width="112" />
                <ComboBox Width="300" IsEditable="True" ItemsSource="{Binding Bancos}" Text="{Binding Banco, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Visibility="{Binding MostrarCheques, Converter={StaticResource BoolAVisibilidad}}">
                <CheckBox Content="Efectivo" IsChecked="{Binding EsEfectivo}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock Text="Cheque 1:" Style="{StaticResource Etiq}" />
                <TextBox Width="90" Text="{Binding Cheque1, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8" />
                <TextBlock Text="Cheque 2:" Style="{StaticResource Etiq}" />
                <TextBox Width="90" Text="{Binding Cheque2, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Subtotal:" Style="{StaticResource Etiq}" />
            <TextBox Grid.Column="1" IsReadOnly="True" HorizontalContentAlignment="Right" Text="{Binding SubtotalTexto, Mode=OneWay}" Margin="0,0,0,8"
                     Visibility="{Binding EsVenta, Converter={StaticResource BoolAVisibilidad}}" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Visibility="{Binding EsVenta, Converter={StaticResource BoolAVisibilidad}}">
              <TextBlock Text="Descuento (%):" Style="{StaticResource Etiq}" />
              <TextBox Width="60" HorizontalContentAlignment="Right" Text="{Binding Descuento, StringFormat='0.##', UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
            </StackPanel>
            <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" HorizontalContentAlignment="Right" Text="{Binding DescuentoTexto, Mode=OneWay}" Margin="0,0,0,8"
                     Visibility="{Binding EsVenta, Converter={StaticResource BoolAVisibilidad}}" />
            <TextBlock Grid.Row="2" Text="TOTAL RECIBO:" FontSize="15" FontWeight="Medium" Foreground="{StaticResource Brush.Primario}" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" HorizontalContentAlignment="Right" FontWeight="Medium" FontSize="15"
                     IsReadOnly="{Binding EsVenta}" Text="{Binding TotalTraslado, StringFormat='#,##0', UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding EsTraslado, Converter={StaticResource BoolAVisibilidad}}" />
            <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Brush.AvisoFondo}" BorderBrush="{StaticResource Brush.Arena}" BorderThickness="1" CornerRadius="4" Padding="8,5"
                    Visibility="{Binding EsVenta, Converter={StaticResource BoolAVisibilidad}}">
              <TextBlock Text="{Binding TotalTexto}" FontSize="15" FontWeight="Medium" Foreground="{StaticResource Brush.Primario}" HorizontalAlignment="Right" />
            </Border>
          </Grid>
        </Border>
      </Grid>

      <DockPanel Margin="0,12,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="💾  GUARDAR RECIBO" Command="{Binding AceptarCommand}" Style="{StaticResource Boton.Primario}" Padding="16,10" IsDefault="True" />
          <Button Margin="10,0,0,0" Content="CANCELAR" Command="{Binding CancelarCommand}" Padding="14,10" IsCancel="True" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Observaciones:" Style="{StaticResource Etiq}" Margin="0,0,8,0" />
          <TextBox Width="300" Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
