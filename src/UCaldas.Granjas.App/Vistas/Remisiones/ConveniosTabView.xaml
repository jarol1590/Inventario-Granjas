<UserControl x:Class="UCaldas.Granjas.App.Vistas.Remisiones.ConveniosTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Convenios institucionales que pueden ser compradores en una venta. Un convenio inactivo deja de ofrecerse, pero conserva sus remisiones." Style="{StaticResource Texto.Suave}" Margin="0,0,0,10" />
    <DataGrid Grid.Row="1" ItemsSource="{Binding Convenios}" SelectedItem="{Binding Seleccionado}">
      <DataGrid.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditarCommand}" />
      </DataGrid.InputBindings>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="1.6*" MinWidth="170" />
        <DataGridTextColumn Header="NIT" Binding="{Binding Nit}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="1.4*" MinWidth="150" />
        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Correo electrónico" Binding="{Binding CorreoElectronico}" Width="1.2*" MinWidth="150" />
        <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo, Mode=OneWay}" Width="Auto" MinWidth="70" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>
    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
      <Button Content="+ AGREGAR CONVENIO" Command="{Binding AgregarCommand}" Style="{StaticResource Boton.Primario}" Padding="14,9" Margin="0,0,10,6" />
      <Button Content="✏ EDITAR" Command="{Binding EditarCommand}" Padding="14,9" Margin="0,0,10,6" />
      <Button Content="{Binding TextoEstado}" Command="{Binding CambiarEstadoCommand}" Padding="14,9" Margin="0,0,10,6" />
    </WrapPanel>
  </Grid>
</UserControl>
