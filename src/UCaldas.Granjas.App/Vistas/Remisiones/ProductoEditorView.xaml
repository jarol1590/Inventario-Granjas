<UserControl x:Class="UCaldas.Granjas.App.Vistas.Remisiones.ProductoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="26,22,26,22">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="*Programa:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" Margin="0,0,0,10" ItemsSource="{Binding Programas}" SelectedItem="{Binding Programa}" DisplayMemberPath="Nombre" />
      <TextBlock Grid.Row="1" Text="*Código:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
      <TextBlock Grid.Row="2" Text="*Producto:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />
      <TextBlock Grid.Row="3" Text="*Unidad de medida:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" VerticalAlignment="Center" />
      <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" IsEditable="True" ItemsSource="{Binding Unidades}" Text="{Binding Unidad, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Grid.Row="4" Text="Precio sugerido ($):" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" VerticalAlignment="Center" />
      <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" HorizontalContentAlignment="Right" Text="{Binding Precio, StringFormat='#,##0', UpdateSourceTrigger=LostFocus}" />
      <TextBlock Grid.Row="5" Text="Estado:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" />
      <CheckBox Grid.Row="5" Grid.Column="1" Content="Activo" IsChecked="{Binding Activo}" VerticalAlignment="Center" />
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="GUARDAR" Command="{Binding GuardarCommand}" Style="{StaticResource Boton.Primario}" IsDefault="True" MinWidth="110" />
      <Button Margin="10,0,0,0" Content="Cancelar" Command="{Binding CancelarCommand}" IsCancel="True" MinWidth="90" />
    </StackPanel>
  </StackPanel>
</UserControl>
