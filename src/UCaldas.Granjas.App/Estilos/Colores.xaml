<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Paleta institucional. Azul Universidad de Caldas: #1B365D (el mismo de los informes de Excel). -->
  <Color x:Key="Color.Primario">#1B365D</Color>
  <Color x:Key="Color.Acento">#86AEE8</Color>
  <Color x:Key="Color.Fondo">#F3F5F9</Color>
  <Color x:Key="Color.Borde">#C6CEDB</Color>
  <Color x:Key="Color.Texto">#1F2937</Color>
  <Color x:Key="Color.Peligro">#B3261E</Color>

  <SolidColorBrush x:Key="Brush.Primario" Color="{StaticResource Color.Primario}" />
  <SolidColorBrush x:Key="Brush.Acento" Color="{StaticResource Color.Acento}" />
  <SolidColorBrush x:Key="Brush.Fondo" Color="{StaticResource Color.Fondo}" />
  <SolidColorBrush x:Key="Brush.Superficie" Color="White" />
  <SolidColorBrush x:Key="Brush.Borde" Color="{StaticResource Color.Borde}" />
  <SolidColorBrush x:Key="Brush.BordeSuave" Color="#E1E6EE" />
  <SolidColorBrush x:Key="Brush.Texto" Color="{StaticResource Color.Texto}" />
  <SolidColorBrush x:Key="Brush.TextoSuave" Color="#5B6577" />
  <SolidColorBrush x:Key="Brush.Peligro" Color="{StaticResource Color.Peligro}" />
  <SolidColorBrush x:Key="Brush.Exito" Color="#2E7D32" />
  <SolidColorBrush x:Key="Brush.Advertencia" Color="#B26A00" />
  <SolidColorBrush x:Key="Brush.FilaAlterna" Color="#EEF2F8" />
  <SolidColorBrush x:Key="Brush.Seleccion" Color="#D5E3F8" />
  <SolidColorBrush x:Key="Brush.Resaltado" Color="#E6EEFA" />
  <SolidColorBrush x:Key="Brush.Deshabilitado" Color="#F1F3F7" />

  <FontFamily x:Key="Fuente.Iconos">Segoe UI Emoji, Segoe UI Symbol</FontFamily>

</ResourceDictionary>
