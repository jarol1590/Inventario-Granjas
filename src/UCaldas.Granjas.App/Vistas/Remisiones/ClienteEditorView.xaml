<UserControl x:Class="UCaldas.Granjas.App.Vistas.Remisiones.ClienteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="26,22,26,22">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="*Nombre / razón social:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Margin="0,0,0,10" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />
      <TextBlock Grid.Row="1" Text="NIT / Cédula:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Nit, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
      <TextBlock Grid.Row="2" Text="Dirección:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" />
      <TextBlock Grid.Row="3" Text="Teléfono:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" VerticalAlignment="Center" />
      <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
      <TextBlock Grid.Row="4" Text="Correo electrónico:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" />
      <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="GUARDAR" Command="{Binding GuardarCommand}" Style="{StaticResource Boton.Primario}" IsDefault="True" MinWidth="110" />
      <Button Margin="10,0,0,0" Content="Cancelar" Command="{Binding CancelarCommand}" IsCancel="True" MinWidth="90" />
    </StackPanel>
  </StackPanel>
</UserControl>
