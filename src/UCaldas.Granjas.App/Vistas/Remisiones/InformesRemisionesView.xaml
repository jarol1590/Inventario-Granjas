<UserControl x:Class="UCaldas.Granjas.App.Vistas.Remisiones.InformesRemisionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,12,0" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="INFORMES DEL MÓDULO REMISIONES" Style="{StaticResource Texto.Titulo}" />

      <TextBlock Margin="0,22,0,10" Text="1. INFORME" Style="{StaticResource Texto.Seccion}" />
      <Border Style="{StaticResource Tarjeta}">
        <StackPanel>
          <TextBlock Text="Ventas por Programas" FontSize="14" FontWeight="Medium" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Texto.Suave}" TextWrapping="Wrap"
                     Text="Solo remisiones de VENTA vigentes, con una hoja por programa (oficio, remisión, recibo de caja, cliente, año, mes, producto, cantidad, valor unitario y total, con subtotal) y una hoja final «Consolidado» que reúne todos los programas por oficio, con subtotal por programa, total general y firma institucional." />
        </StackPanel>
      </Border>

      <TextBlock Margin="0,26,0,10" Text="2. PARÁMETROS" Style="{StaticResource Texto.Seccion}" />
      <Border Style="{StaticResource Tarjeta}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Desde:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker Width="140" SelectedDate="{Binding Desde, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Hasta:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="24,0,8,0" />
            <DatePicker Width="140" SelectedDate="{Binding Hasta, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Programa:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="280" ItemsSource="{Binding Programas}" SelectedItem="{Binding Programa}" DisplayMemberPath="Nombre" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Margin="0,26,0,10" Text="3. GENERE EL ARCHIVO" Style="{StaticResource Texto.Seccion}" />
      <StackPanel Orientation="Horizontal">
        <Button Content="📊 GENERAR INFORME DE VENTAS" Command="{Binding GenerarCommand}" Style="{StaticResource Boton.Primario}" Padding="18,11" />
        <Button Margin="10,0,0,0" Content="Abrir último" Command="{Binding AbrirUltimoCommand}" />
      </StackPanel>
      <TextBlock Margin="0,10,0,24" Text="{Binding UltimoArchivo, StringFormat='Último informe: {0}'}" Style="{StaticResource Texto.Suave}"
                 Visibility="{Binding UltimoArchivo, Converter={StaticResource NuloAVisibilidad}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
