<UserControl x:Class="UCaldas.Granjas.App.Vistas.TrasladosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <TextBlock Text="Traslados entre Granjas" Style="{StaticResource Texto.Titulo}" VerticalAlignment="Center" Margin="0,0,28,0" />
      <ContentControl Content="{Binding Rango}" VerticalAlignment="Center" IsTabStop="False" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,16,0,0">
      <TextBlock Text="Resumen del período" FontSize="15" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,8" />
      <UniformGrid Rows="1" Columns="2" HorizontalAlignment="Left" Width="520">
        <Border Style="{StaticResource Tarjeta}" Margin="0,0,10,0" Padding="12,10">
          <StackPanel>
            <TextBlock Text="Traslados Realizados" Style="{StaticResource Texto.KpiEtiqueta}" />
            <TextBlock Text="{Binding TrasladosRealizados}" Style="{StaticResource Texto.KpiValor}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Tarjeta}" Padding="12,10">
          <StackPanel>
            <TextBlock Text="Animales Movidos" Style="{StaticResource Texto.KpiEtiqueta}" />
            <TextBlock Text="{Binding AnimalesMovidos}" Style="{StaticResource Texto.KpiValor}" />
          </StackPanel>
        </Border>
      </UniformGrid>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,12">
      <TextBlock Text="Buscar" FontSize="15" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,0" />
      <Grid Width="270">
        <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding BuscarCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <TextBlock Text="🔍 Remisión o Chapeta Amarilla" Style="{StaticResource Texto.Marcador}"
                   Visibility="{Binding Texto, Converter={StaticResource NuloAVisibilidad}, ConverterParameter=invertir}" />
      </Grid>
      <Button Margin="10,0,0,0" Content="Buscar" Command="{Binding BuscarCommand}" MinWidth="90" />
      <Button Margin="10,0,0,0" Content="+ Registrar Traslado" Command="{Binding RegistrarTrasladoCommand}" Style="{StaticResource Boton.Primario}" />
      <CheckBox Margin="22,0,0,0" Content="Incluir anulados" IsChecked="{Binding IncluirAnulados}" VerticalAlignment="Center" />
    </StackPanel>

    <DataGrid Grid.Row="3" ItemsSource="{Binding Traslados}" SelectedItem="{Binding Seleccionado}">
      <DataGrid.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding VerDetalleCommand}" CommandParameter="{Binding Seleccionado}" />
      </DataGrid.InputBindings>
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Anulado}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Peligro}" />
              <Setter Property="ToolTip" Value="Traslado anulado" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Fecha Traslado" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy'}" Width="1*" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="N° Remisión" Binding="{Binding NumeroRemision}" Width="1.3*" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Granja Origen" Binding="{Binding Origen}" Width="1.3*" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Granja Destino" Binding="{Binding Destino}" Width="1.3*" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="0.8*" ElementStyle="{StaticResource Celda.Centro}" />
      </DataGrid.Columns>
    </DataGrid>

    <UniformGrid Grid.Row="4" Rows="1" Margin="0,14,0,0">
      <Button Margin="0,0,-1,0" Padding="10,11" Content="👁 VER DETALLE TRASLADO" Command="{Binding VerDetalleCommand}" CommandParameter="{Binding Seleccionado}"
              ToolTip="También puede abrirlo con doble clic. Desde el detalle se puede editar o anular." />
      <Button Margin="0,0,-1,0" Padding="10,11" Content="⊘ ANULAR TRASLADO" Command="{Binding AnularCommand}" Style="{StaticResource Boton.Peligro}" />
      <Button Padding="10,11" Content="📊 GENERAR INFORME" Command="{Binding GenerarInformeCommand}" />
    </UniformGrid>
  </Grid>
</UserControl>
