<UserControl x:Class="UCaldas.Granjas.App.Vistas.Remisiones.ProgramasTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Style="{StaticResource Texto.Suave}" TextWrapping="Wrap" Margin="0,0,0,10"
               Text="Programas productivos. Los de animales (bovinos, aves...) llevan inventario; los de productos (hortalizas, frutales...) solo catálogo de productos. Se crean y editan en Configuración › Granjas y Programas." />
    <DataGrid Grid.Row="1" ItemsSource="{Binding Programas}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{Binding Programa.Codigo}" Width="Auto" MinWidth="95" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Nombre" Binding="{Binding Programa.Nombre}" Width="1.5*" MinWidth="180" />
        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="1.2*" MinWidth="150" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Maneja inventario animal" Binding="{Binding ManejaAnimales}" Width="Auto" MinWidth="170" ElementStyle="{StaticResource Celda.Centro}" />
      </DataGrid.Columns>
    </DataGrid>
    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
      <Button Content="⚙ ADMINISTRAR PROGRAMAS" Command="{Binding AdministrarProgramasCommand}" Padding="14,9" />
    </WrapPanel>
  </Grid>
</UserControl>
