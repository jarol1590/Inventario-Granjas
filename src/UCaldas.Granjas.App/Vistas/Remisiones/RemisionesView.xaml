<UserControl x:Class="UCaldas.Granjas.App.Vistas.Remisiones.RemisionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <TextBlock Text="Remisiones" Style="{StaticResource Texto.Titulo}" VerticalAlignment="Center" Margin="0,0,28,0" />
      <ContentControl Content="{Binding Rango}" VerticalAlignment="Center" IsTabStop="False" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
      <Border Style="{StaticResource Tarjeta}" Width="270" Margin="0,0,10,0" Padding="12,8">
        <StackPanel>
          <TextBlock Text="Remisiones emitidas (mes)" Style="{StaticResource Texto.KpiEtiqueta}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding RemisionesDelMes}" Style="{StaticResource Texto.KpiValor}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tarjeta}" Width="270" Padding="12,8">
        <StackPanel>
          <TextBlock Text="Total ventas (mes)" Style="{StaticResource Texto.KpiEtiqueta}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding VentasDelMesTexto}" Style="{StaticResource Texto.KpiValor}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,10">
      <TextBlock Text="Clase" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="140" ItemsSource="{Binding Clases}" SelectedItem="{Binding Clase}" DisplayMemberPath="Nombre" Margin="0,0,22,0" />
      <TextBlock Text="Estado" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="160" ItemsSource="{Binding Estados}" SelectedItem="{Binding Estado}" DisplayMemberPath="Nombre" Margin="0,0,22,0" />
      <TextBlock Text="🔍 Buscar" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Width="200" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" ToolTip="N° de remisión, oficio, recibo o cliente" />
    </StackPanel>

    <DataGrid Grid.Row="3" ItemsSource="{Binding Remisiones}" SelectedItem="{Binding Seleccionada}">
      <DataGrid.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding VerDetalleCommand}" CommandParameter="{Binding Seleccionada}" />
      </DataGrid.InputBindings>
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Anulada}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Peligro}" />
              <Setter Property="ToolTip" Value="Remisión anulada" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="N° Remisión" Binding="{Binding Numero}" Width="Auto" MinWidth="95" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy'}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Clase" Binding="{Binding ClaseTexto}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Oficio" Binding="{Binding Oficio, TargetNullValue='N/A'}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Programa" Binding="{Binding Programa}" Width="1.2*" MinWidth="130" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Comprador" Binding="{Binding ClienteODestino}" Width="1.4*" MinWidth="150" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Valor total" Binding="{Binding Total, StringFormat='$#,##0'}" Width="Auto" MinWidth="105" ElementStyle="{StaticResource Celda.Derecha}" />
        <DataGridTextColumn Header="Recibo SP" Binding="{Binding Recibo, TargetNullValue='-'}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="Auto" MinWidth="125" ElementStyle="{StaticResource Celda.Centro}" />
      </DataGrid.Columns>
    </DataGrid>

    <UniformGrid Grid.Row="4" Rows="1" Margin="0,14,0,0">
      <Button Margin="0,0,-1,0" Padding="10,11" Content="+ NUEVA REMISIÓN" Command="{Binding NuevaRemisionCommand}" Style="{StaticResource Boton.Primario}" />
      <Button Margin="0,0,-1,0" Padding="10,11" Content="🧾 VER / EDITAR RECIBO SP" Command="{Binding GenerarReciboCommand}" />
      <Button Margin="0,0,-1,0" Padding="10,11" Content="👁 VER DETALLE" Command="{Binding VerDetalleCommand}" CommandParameter="{Binding Seleccionada}" />
      <Button Padding="10,11" Content="🖨 IMPRIMIR REMISIÓN" Command="{Binding ImprimirRemisionCommand}" />
    </UniformGrid>
  </Grid>
</UserControl>
