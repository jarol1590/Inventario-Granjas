<Window x:Class="UCaldas.Granjas.App.Vistas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventario Sistema Granjas"
        Width="1220" Height="800" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Fondo}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Cabecera: logo institucional + barra de módulos (o pestañas de Configuración) -->
    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Brush.Borde}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="176" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource Brush.Primario}">
            <TextBlock Text="UC" Foreground="White" FontSize="17" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Margin="8,0,0,0" Text="Universidad&#x0A;de Caldas" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource Brush.Primario}" VerticalAlignment="Center" />
        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding BarraSuperior}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Menú lateral -->
      <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Brush.Borde}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Margin="14,10,14,16" HorizontalContentAlignment="Left" AutomationProperties.Name="Salir"
                  Style="{StaticResource Boton.Enlace}" Command="{Binding SalirCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🚪" FontFamily="{StaticResource Fuente.Iconos}" Margin="0,0,8,0" />
              <TextBlock Text="Salir" FontSize="15" />
            </StackPanel>
          </Button>
          <TextBlock DockPanel.Dock="Top" Text="Menú" Style="{StaticResource Texto.Titulo}" Margin="16,16,0,8" />
          <ListBox ItemsSource="{Binding Menu.Pestanas}" SelectedItem="{Binding Menu.Seleccionada, Mode=TwoWay}"
                   Style="{StaticResource Menu.Lista}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource Fuente.Iconos}" Width="28" FontSize="15" />
                  <TextBlock Text="{Binding Titulo}" FontSize="14" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Contenido -->
      <Grid Grid.Column="1" Margin="24,14,24,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filtros globales -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,12" BorderBrush="{StaticResource Brush.Borde}" BorderThickness="0,0,0,1"
                Visibility="{Binding MostrarFiltros, Converter={StaticResource BoolAVisibilidad}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Granja" FontSize="16" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,0" />
            <ComboBox Width="210" ItemsSource="{Binding Granjas}" SelectedItem="{Binding GranjaSeleccionada}" DisplayMemberPath="Nombre" />
            <TextBlock Text="Programa" FontSize="16" Style="{StaticResource Texto.Etiqueta}" Margin="40,0,10,0" />
            <ComboBox Width="210" ItemsSource="{Binding Programas}" SelectedItem="{Binding ProgramaSeleccionado}" DisplayMemberPath="Nombre" />
          </StackPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding Contenido}" IsTabStop="False" />

        <!-- Acciones rápidas (Inicio y Bovinos) -->
        <UniformGrid Grid.Row="2" Rows="1" Margin="0,12,0,0"
                     Visibility="{Binding MostrarAccionesRapidas, Converter={StaticResource BoolAVisibilidad}}">
          <Button Command="{Binding RegistrarNacimientoCommand}" Margin="0,0,-1,0" Padding="10,11" AutomationProperties.Name="Registro nacimiento">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🐄" FontFamily="{StaticResource Fuente.Iconos}" Margin="0,0,8,0" />
              <TextBlock Text="REGISTRO NACIMIENTO" />
            </StackPanel>
          </Button>
          <Button Command="{Binding RegistrarCompraCommand}" Margin="0,0,-1,0" Padding="10,11" AutomationProperties.Name="Registro compra">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="📦" FontFamily="{StaticResource Fuente.Iconos}" Margin="0,0,8,0" />
              <TextBlock Text="REGISTRO COMPRA" />
            </StackPanel>
          </Button>
          <Button Command="{Binding IrASalidasCommand}" Margin="0,0,-1,0" Padding="10,11" AutomationProperties.Name="Salidas y bajas">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🛒" FontFamily="{StaticResource Fuente.Iconos}" Margin="0,0,8,0" />
              <TextBlock Text="SALIDAS / BAJAS" />
            </StackPanel>
          </Button>
          <Button Command="{Binding IrAInformesCommand}" Padding="10,11" AutomationProperties.Name="Generar informe">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="📊" FontFamily="{StaticResource Fuente.Iconos}" Margin="0,0,8,0" />
              <TextBlock Text="GENERAR INFORME" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </Grid>

      <ProgressBar Grid.Column="1" VerticalAlignment="Top" Height="3" IsIndeterminate="True" BorderThickness="0"
                   Foreground="{StaticResource Brush.Primario}" Background="Transparent"
                   Visibility="{Binding EstaOcupado, Converter={StaticResource BoolAVisibilidad}}" />
    </Grid>
  </Grid>
</Window>
