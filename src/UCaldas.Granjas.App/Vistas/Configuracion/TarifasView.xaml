<UserControl x:Class="UCaldas.Granjas.App.Vistas.Configuracion.TarifasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Vigencia -->
    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <TextBlock Text="Vigencia de Precios:" Style="{StaticResource Texto.Etiqueta}" FontSize="14" Margin="0,0,10,0" />
      <ComboBox Width="190" ItemsSource="{Binding Vigencias}" SelectedItem="{Binding VigenciaSeleccionada}" DisplayMemberPath="Texto" />
      <Button Margin="18,0,0,0" Content="+ CREAR LISTA NUEVO AÑO" Command="{Binding CrearNuevoAnioCommand}" />
      <Button Margin="10,0,0,0" Content="📋 CLONAR DEL AÑO ANTERIOR" Command="{Binding ClonarCommand}" />
    </StackPanel>

    <TextBlock Grid.Row="1" Margin="0,18,0,10" Text="{Binding TituloTabla}" Style="{StaticResource Texto.Titulo}" />

    <!-- Matriz editable -->
    <DataGrid Grid.Row="2" ItemsSource="{Binding Filas}" SelectedItem="{Binding FilaSeleccionada}" IsReadOnly="False"
              SelectionUnit="FullRow" VerticalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Categoría" Width="1.5*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.Categorias, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        DisplayMemberPath="Nombre" SelectedValuePath="Id"
                        SelectedValue="{Binding CategoriaId, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Edad Mín. (meses)" Width="1*" MinWidth="140">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding EdadMinimaMeses, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Edad Máx. (meses)" Width="1*" MinWidth="140">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding EdadMaximaMeses, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Sexo" Width="1*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.Sexos, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        SelectedItem="{Binding Sexo, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Orientación" Width="1.3*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.Orientaciones, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        DisplayMemberPath="Nombre" SelectedValuePath="Id"
                        SelectedValue="{Binding OrientacionClave, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Requiere Parto" Width="1.3*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding RequierePartos, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                        Content="Sí (≥ 1 parto)" ToolTip="Si está marcada, la tarifa solo aplica a hembras con al menos un parto registrado." />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Valor Base $" Width="1.2*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding ValorBase, StringFormat='#,##0', UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="✕" ToolTip="Quitar esta fila" Style="{StaticResource Boton.Peligro}" Padding="8,3"
                      Command="{Binding DataContext.QuitarFilaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="+ Agregar Fila de Tarifa" Command="{Binding AgregarFilaCommand}" />
      <Button Margin="10,0,0,0" Content="% Reajuste porcentual" Command="{Binding ReajustarCommand}"
              ToolTip="Aumenta o reduce todos los valores base en un porcentaje (se revisa antes de guardar)." />
      <Button Margin="10,0,0,0" Content="📅 Valorizar inventario a una fecha…" Command="{Binding ValorizarAFechaCommand}"
              ToolTip="El cierre de cada mes se hace solo al abrir el sistema. Use esto para valorizar a otra fecha con la matriz activa." />
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="💾 GUARDAR TARIFAS" Command="{Binding GuardarCommand}" Style="{StaticResource Boton.Primario}" />
      <Button Margin="10,0,0,0" Content="🔒 ACTIVAR ESTA VIGENCIA" Command="{Binding ActivarCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
