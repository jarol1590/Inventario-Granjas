<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PROTOTIPO VISUAL (solo XAML) del módulo Remisiones / Oficios / Recibos de Caja.
    Datos quemados para validar campos y flujo con la persona encargada del sistema.
    No referencia Domain, Services ni Data (no ve la base de datos) y no forma parte de SistemaGranjas.sln.
    Ejecutar con:  dotnet run (opción de proyecto) prototipos/UCaldas.Granjas.PrototipoRemisiones
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PrototipoRemisiones</AssemblyName>
    <RootNamespace>UCaldas.Granjas.PrototipoRemisiones</RootNamespace>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <ApplicationIcon>..\..\src\UCaldas.Granjas.App\Recursos\Imagenes\SistemaGranjas.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Identidad visual compartida con la aplicación: se ENLAZAN los archivos (no se copian). -->
  <ItemGroup>
    <Page Include="..\..\src\UCaldas.Granjas.App\Estilos\Colores.xaml" Link="Estilos\Colores.xaml" />
    <Page Include="..\..\src\UCaldas.Granjas.App\Estilos\Controles.xaml" Link="Estilos\Controles.xaml" />
    <!-- Controles.xaml usa estos convertidores (solo dependen de WPF). -->
    <Compile Include="..\..\src\UCaldas.Granjas.App\Infraestructura\Convertidores.cs" Link="Infraestructura\Convertidores.cs" />
    <Resource Include="..\..\src\UCaldas.Granjas.App\Recursos\Fuentes\*.ttf" LinkBase="Recursos\Fuentes" />
    <Resource Include="..\..\src\UCaldas.Granjas.App\Recursos\Imagenes\LogoUniversidadDeCaldas.png" Link="Recursos\Imagenes\LogoUniversidadDeCaldas.png" />
  </ItemGroup>

</Project>
