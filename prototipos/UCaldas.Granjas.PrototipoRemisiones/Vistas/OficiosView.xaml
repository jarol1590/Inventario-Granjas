<UserControl x:Class="UCaldas.Granjas.PrototipoRemisiones.Vistas.OficiosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Margin="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="➕  NUEVO OFICIO DE VENTA" Style="{StaticResource Boton.Primario}" Padding="15,9" VerticalAlignment="Center" />
      <StackPanel>
        <TextBlock Text="Oficios de Venta por Programa" Style="{StaticResource Texto.Titulo}" />
        <TextBlock Text="Documento exclusivo para operaciones de VENTA. Cada oficio agrupa remisiones de un solo programa."
                   Style="{StaticResource Texto.Suave}" FontSize="12" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- Filtros -->
    <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="10" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Filtrar por programa:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Width="220" SelectedIndex="0" Margin="0,0,20,0">
          <ComboBoxItem Content="Todos los Programas" />
          <ComboBoxItem Content="Ganado Lácteo" />
          <ComboBoxItem Content="Hortalizas Clima Frío" />
          <ComboBoxItem Content="Frutales Clima Cálido" />
          <ComboBoxItem Content="Avicultura" />
        </ComboBox>
        <TextBlock Text="🔍 Buscar N° oficio:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Width="180" ToolTip="Ej: OF-123" />
      </StackPanel>
    </Border>

    <!-- Listado maestro -->
    <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,0,12">
      <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="36" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.Primario}" CornerRadius="5,5,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="o0" />
              <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="o1" />
              <ColumnDefinition Width="Auto" MinWidth="230" SharedSizeGroup="o2" />
              <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="o3" />
              <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="o4" />
              <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="N° Oficio" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="1" Text="Fecha" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="2" Text="Programa exclusivo" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="3" Text="Cant. remisiones" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="4" Text="Total vendido" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="5" Text="Concepto / Observaciones" Style="{StaticResource Encab}" />
          </Grid>
        </Border>

        <StackPanel Grid.Row="1">
          <Border Background="{StaticResource Brush.InfoFondo}" BorderBrush="{StaticResource Brush.PrimarioClaro}" BorderThickness="0,1" Padding="0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="o0" /><ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="o1" /><ColumnDefinition Width="Auto" MinWidth="230" SharedSizeGroup="o2" />
                <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="o3" /><ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="o4" /><ColumnDefinition Width="*" MinWidth="200" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="▶ OF-123" Style="{StaticResource CelNegrita}" Foreground="{StaticResource Brush.Primario}" />
              <TextBlock Grid.Column="1" Text="10/11/2026" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="2" Text="Ganado Lácteo" Style="{StaticResource CelNegrita}" />
              <TextBlock Grid.Column="3" Text="3 remisiones" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="4" Text="$ 14.500.000" Style="{StaticResource CelNegrita}" Foreground="{StaticResource Brush.Exito}" />
              <TextBlock Grid.Column="5" Text="Autorización venta semovientes descarte Tesorito" Style="{StaticResource Cel}" Foreground="{StaticResource Brush.TextoSuave}" />
            </Grid>
          </Border>
          <Border BorderBrush="{StaticResource Brush.BordeSuave}" BorderThickness="0,0,0,1" Padding="0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="o0" /><ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="o1" /><ColumnDefinition Width="Auto" MinWidth="230" SharedSizeGroup="o2" />
                <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="o3" /><ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="o4" /><ColumnDefinition Width="*" MinWidth="200" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="   OF-124" Style="{StaticResource CelNegrita}" />
              <TextBlock Grid.Column="1" Text="12/11/2026" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="2" Text="Hortalizas Clima Frío" Style="{StaticResource CelNegrita}" />
              <TextBlock Grid.Column="3" Text="20 remisiones" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="4" Text="$ 3.890.000" Style="{StaticResource CelNegrita}" Foreground="{StaticResource Brush.Exito}" />
              <TextBlock Grid.Column="5" Text="Cosecha quincenal hortalizas varios clientes" Style="{StaticResource Cel}" Foreground="{StaticResource Brush.TextoSuave}" />
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Grid.Row="3" Text="Remisiones de venta vinculadas al oficio seleccionado: OF-123 (Ganado Lácteo)" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,8" />

    <!-- Remisiones del oficio -->
    <Border Grid.Row="4" Style="{StaticResource Tarjeta}" Padding="0" VerticalAlignment="Top">
      <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="34" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.PrimarioClaro}" CornerRadius="5,5,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="r0" /><ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="r1" /><ColumnDefinition Width="*" MinWidth="260" />
              <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="r3" /><ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="r4" /><ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="r5" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="N° Remisión" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="1" Text="Fecha" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="2" Text="Cliente" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="3" Text="Valor remisión" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="4" Text="Recibo de caja" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="5" Text="Estado" Style="{StaticResource Encab}" />
          </Grid>
        </Border>

        <StackPanel Grid.Row="1">
          <Border BorderBrush="{StaticResource Brush.BordeSuave}" BorderThickness="0,0,0,1" Padding="0,9">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="r0" /><ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="r1" /><ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="r3" /><ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="r4" /><ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="r5" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="REM-405" Style="{StaticResource CelNegrita}" />
              <TextBlock Grid.Column="1" Text="11/11/2026" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="2" Text="Carlos Andrés Gómez (CC 75.088.123)" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="3" Text="$ 4.500.000" Style="{StaticResource CelNegrita}" />
              <TextBlock Grid.Column="4" Text="SP-825" Style="{StaticResource CelNegrita}" Foreground="{StaticResource Brush.Exito}" />
              <TextBlock Grid.Column="5" Text="Pagada" Style="{StaticResource CelNegrita}" Foreground="{StaticResource Brush.Exito}" />
            </Grid>
          </Border>
          <Border BorderBrush="{StaticResource Brush.BordeSuave}" BorderThickness="0,0,0,1" Padding="0,9">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="r0" /><ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="r1" /><ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="r3" /><ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="r4" /><ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="r5" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="REM-408" Style="{StaticResource CelNegrita}" />
              <TextBlock Grid.Column="1" Text="14/11/2026" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="2" Text="Inversiones Caldas S.A.S (NIT 900.123.456)" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="3" Text="$ 4.000.000" Style="{StaticResource CelNegrita}" />
              <TextBlock Grid.Column="4" Text="SP-827" Style="{StaticResource CelNegrita}" Foreground="{StaticResource Brush.Exito}" />
              <TextBlock Grid.Column="5" Text="Pagada" Style="{StaticResource CelNegrita}" Foreground="{StaticResource Brush.Exito}" />
            </Grid>
          </Border>
          <Border BorderBrush="{StaticResource Brush.BordeSuave}" BorderThickness="0,0,0,1" Padding="0,9">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="r0" /><ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="r1" /><ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="r3" /><ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="r4" /><ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="r5" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="REM-410" Style="{StaticResource CelNegrita}" />
              <TextBlock Grid.Column="1" Text="17/11/2026" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="2" Text="Agropecuaria El Ruiz (NIT 890.441.220)" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="3" Text="$ 6.000.000" Style="{StaticResource CelNegrita}" />
              <TextBlock Grid.Column="4" Text="SP-828" Style="{StaticResource CelNegrita}" Foreground="{StaticResource Brush.Exito}" />
              <TextBlock Grid.Column="5" Text="Pagada" Style="{StaticResource CelNegrita}" Foreground="{StaticResource Brush.Exito}" />
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="➕  AGREGAR REMISIÓN DE VENTA A ESTE OFICIO (OF-123)" Style="{StaticResource Boton.Primario}" Padding="15,9" Margin="0,0,10,0" />
      <Button Content="🖨️  IMPRIMIR RELACIÓN DEL OFICIO" Padding="14,9" />
    </StackPanel>
  </Grid>
</UserControl>
