<Window x:Class="UCaldas.Granjas.App.Vistas.InicializacionPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:UCaldas.Granjas.App.Infraestructura"
        Title="Inventario Sistema Granjas — Primer uso"
        Icon="/Recursos/Imagenes/SistemaGranjas.ico"
        FontFamily="{StaticResource Fuente.Base}"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Fondo}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=CampoContrasena}">
  <!-- Primer inicio: contraseña, pregunta secreta y clave de recuperación. Todo se guarda como hash en la base local. -->
  <Border Margin="24" Style="{StaticResource Tarjeta}" Padding="0">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Height="6" CornerRadius="5,5,0,0" Background="{StaticResource Brush.DegradadoFacultad}" />

        <StackPanel Margin="28,18,28,26">
          <Image Source="/Recursos/Imagenes/LogoUniversidadDeCaldas.png" Height="88" HorizontalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Logo de la Universidad de Caldas" />
          <TextBlock Margin="0,12,0,0" Text="Configuración inicial de acceso" Style="{StaticResource Texto.Titulo}" TextAlignment="Center" />
          <TextBlock Margin="0,4,0,0" Text="FACULTAD DE CIENCIAS AGROPECUARIAS" Style="{StaticResource Texto.Identificador}"
                     FontSize="14" TextAlignment="Center" />

          <!-- Paso 1: crear la contraseña y la pregunta secreta -->
          <StackPanel Visibility="{Binding MuestraFormulario, Converter={StaticResource BoolAVisibilidad}}"
                      infra:FocoAlMostrarse.Activo="True" infra:FocoAlMostrarse.Destino="{Binding ElementName=CampoContrasena}">
            <TextBlock Margin="0,16,0,12" Style="{StaticResource Texto.Suave}"
                       Text="Primer uso: cree la contraseña de acceso y elija una pregunta secreta. Si algún día olvida la contraseña, podrá restablecerla con la pregunta secreta o con la clave de recuperación que se generará al terminar, sin perder ningún dato." />

            <TextBlock Text="Contraseña" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,4" />
            <PasswordBox x:Name="CampoContrasena" AutomationProperties.Name="Contraseña"
                         infra:ContrasenaAsistente.Contrasena="{Binding Contrasena, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Confirme la contraseña" Style="{StaticResource Texto.Etiqueta}" Margin="0,10,0,4" />
            <PasswordBox AutomationProperties.Name="Confirme la contraseña"
                         infra:ContrasenaAsistente.Contrasena="{Binding Confirmacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Texto.Suave}"
                       Text="{Binding LongitudMinima, StringFormat='Mínimo {0} caracteres.'}" />

            <TextBlock Text="Pregunta secreta" Style="{StaticResource Texto.Etiqueta}" Margin="0,14,0,4" />
            <ComboBox ItemsSource="{Binding Preguntas}" SelectedItem="{Binding PreguntaSecreta}" AutomationProperties.Name="Pregunta secreta" />

            <TextBlock Text="Respuesta secreta" Style="{StaticResource Texto.Etiqueta}" Margin="0,10,0,4" />
            <TextBox Text="{Binding Respuesta, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Respuesta secreta" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Texto.Suave}"
                       Text="No importan las mayúsculas, las tildes ni los espacios de más. Elija algo que solo usted recuerde." />

            <TextBlock Margin="0,12,0,0" Text="{Binding MensajeError}" Style="{StaticResource Texto.Error}"
                       Visibility="{Binding MensajeError, Converter={StaticResource NuloAVisibilidad}}" />

            <Button Margin="0,18,0,0" Content="CREAR ACCESO Y GENERAR CLAVE DE RECUPERACIÓN" Command="{Binding CrearCommand}"
                    Style="{StaticResource Boton.Primario}" IsDefault="True" Padding="14,10" />
          </StackPanel>

          <!-- Paso 2: la clave de recuperación (copiar o guardar) -->
          <StackPanel Margin="0,16,0,0" Visibility="{Binding MuestraClave, Converter={StaticResource BoolAVisibilidad}}">
            <Border Margin="0,0,0,12" Padding="10,8" CornerRadius="4" Background="#EAF4EE" BorderBrush="{StaticResource Brush.Secundario}" BorderThickness="1">
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.SecundarioOscuro}" FontWeight="Medium"
                         Text="Listo: su contraseña y su pregunta secreta quedaron guardadas." />
            </Border>
            <ContentControl Content="{Binding Clave}" IsTabStop="False" />
            <Button Margin="0,16,0,0" Content="CONTINUAR" Command="{Binding ContinuarCommand}"
                    Style="{StaticResource Boton.Primario}" IsDefault="True" Padding="14,10" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
