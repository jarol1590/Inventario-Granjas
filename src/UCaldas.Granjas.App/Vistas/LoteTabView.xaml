<UserControl x:Class="UCaldas.Granjas.App.Vistas.LoteTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- KPIs -->
    <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,12">
      <Border Style="{StaticResource Tarjeta}" Padding="14,8" Margin="0,0,10,0">
        <StackPanel><TextBlock Text="Población Viva Total" Style="{StaticResource Texto.Suave}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding PoblacionTexto}" FontSize="20" FontWeight="Medium" Foreground="{StaticResource Brush.Primario}" HorizontalAlignment="Center" /></StackPanel>
      </Border>
      <Border Style="{StaticResource Tarjeta}" Padding="14,8" Margin="0,0,10,0"
              ToolTip="Bajas acumuladas sobre la población inicial de los lotes mostrados. La mortandad por mes necesita el Kardex de lotes (pendiente).">
        <StackPanel><TextBlock Text="Mortandad Acumulada" Style="{StaticResource Texto.Suave}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding MortandadTexto}" FontSize="20" FontWeight="Medium" Foreground="{StaticResource Brush.Primario}" HorizontalAlignment="Center" /></StackPanel>
      </Border>
      <Border Style="{StaticResource Tarjeta}" Padding="14,8">
        <StackPanel><TextBlock Text="Saldo Total Lotes" Style="{StaticResource Texto.Suave}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding SaldoTexto}" FontSize="20" FontWeight="Medium" Foreground="{StaticResource Brush.Primario}" HorizontalAlignment="Center" /></StackPanel>
      </Border>
    </UniformGrid>

    <!-- Filtros -->
    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
        <TextBlock Text="Buscar" Style="{StaticResource Texto.Etiqueta}" FontSize="14" Margin="0,0,8,0" />
        <TextBox Width="190" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Código del lote o ubicación" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
        <TextBlock Text="Granja" Style="{StaticResource Texto.Etiqueta}" FontSize="14" Margin="0,0,8,0" />
        <ComboBox Width="140" ItemsSource="{Binding Granjas}" SelectedItem="{Binding GranjaSeleccionada}" DisplayMemberPath="Nombre" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
        <TextBlock Text="Etapa" Style="{StaticResource Texto.Etiqueta}" FontSize="14" Margin="0,0,8,0" />
        <ComboBox Width="150" ItemsSource="{Binding Etapas}" SelectedItem="{Binding EtapaSeleccionada}" DisplayMemberPath="Nombre" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <TextBlock Text="Estado" Style="{StaticResource Texto.Etiqueta}" FontSize="14" Margin="0,0,8,0" />
        <ComboBox Width="120" ItemsSource="{Binding Estados}" SelectedItem="{Binding EstadoSeleccionado}" DisplayMemberPath="Nombre" />
      </StackPanel>
    </WrapPanel>

    <DataGrid Grid.Row="2" ItemsSource="{Binding Lotes}" SelectedItem="{Binding Seleccionado}">
      <DataGrid.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding VerFichaCommand}" />
      </DataGrid.InputBindings>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Cód. Lote" Binding="{Binding Codigo}" Width="1.1*" MinWidth="100" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Granja" Binding="{Binding Granja}" Width="1*" MinWidth="90" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="1*" MinWidth="95" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="1*" MinWidth="100" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Etapa Actual" Binding="{Binding Etapa}" Width="1.1*" MinWidth="105" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Inicial" Binding="{Binding Inicial}" Width="0.8*" MinWidth="70" ElementStyle="{StaticResource Celda.Derecha}" />
        <DataGridTextColumn Header="Bajas" Binding="{Binding Bajas}" Width="0.7*" MinWidth="64" ElementStyle="{StaticResource Celda.Derecha}" />
        <DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="0.8*" MinWidth="70" ElementStyle="{StaticResource Celda.Derecha}" />
        <DataGridTextColumn Header="Valor" Binding="{Binding ValorTotal, StringFormat='$#,##0'}" Width="1.1*" MinWidth="96" ElementStyle="{StaticResource Celda.Derecha}" />
        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="0.8*" MinWidth="80" ElementStyle="{StaticResource Celda.Centro}" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="{Binding ResumenTexto}" FontSize="15" Style="{StaticResource Texto.Etiqueta}" />

    <WrapPanel Grid.Row="4" Margin="0,12,0,0">
      <Button Content="+ NUEVO LOTE" Command="{Binding NuevoLoteCommand}" Style="{StaticResource Boton.Primario}" Margin="0,0,10,6" />
      <Button Content="🔄 CAMBIAR ETAPA / DESDOBLE" Command="{Binding CambiarEtapaCommand}" Margin="0,0,10,6" />
      <Button Content="📉 MORTANDAD / BAJA" Command="{Binding RegistrarBajaCommand}" Margin="0,0,10,6" />
      <Button Content="🪪 VER FICHA" Command="{Binding VerFichaCommand}" Margin="0,0,10,6" ToolTip="También con doble clic sobre el lote." />
      <Button Content="📊 KARDEX" IsEnabled="False" Margin="0,0,0,6" ToolTip="El Kardex de lotes todavía no está disponible." />
    </WrapPanel>
  </Grid>
</UserControl>