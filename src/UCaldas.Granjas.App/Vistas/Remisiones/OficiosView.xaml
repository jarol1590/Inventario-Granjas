<UserControl x:Class="UCaldas.Granjas.App.Vistas.Remisiones.OficiosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1.1*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <Button DockPanel.Dock="Right" Content="➕  NUEVO OFICIO DE VENTA" Command="{Binding NuevoOficioCommand}" Style="{StaticResource Boton.Primario}" Padding="15,9" VerticalAlignment="Center" />
      <StackPanel>
        <TextBlock Text="Oficios de Venta por Programa" Style="{StaticResource Texto.Titulo}" />
        <TextBlock Text="Documento exclusivo de las ventas. Cada oficio agrupa remisiones de un solo programa y se puede cerrar para no admitir más."
                   Style="{StaticResource Texto.Suave}" FontSize="12" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="🔍 Buscar oficio" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Width="220" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Número u observaciones del oficio" />
      <TextBlock Text="El programa se filtra con el combo de la parte superior." Style="{StaticResource Texto.Suave}" FontSize="11.5" Margin="16,0,0,0" VerticalAlignment="Center" />
    </StackPanel>

    <DataGrid Grid.Row="2" ItemsSource="{Binding Oficios}" SelectedItem="{Binding Seleccionado}">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Oficio.Cerrado}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.TextoSuave}" />
              <Setter Property="ToolTip" Value="Oficio cerrado: no admite remisiones nuevas" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="N° Oficio" Binding="{Binding Oficio.NumeroOficio}" Width="Auto" MinWidth="95" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Fecha" Binding="{Binding Oficio.FechaOficio, StringFormat='dd/MM/yyyy'}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Programa exclusivo" Binding="{Binding ProgramaNombre}" Width="1.2*" MinWidth="150" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Remisiones" Binding="{Binding Remisiones}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Total vendido" Binding="{Binding TotalVendido, StringFormat='$#,##0'}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource Celda.Derecha}" />
        <DataGridTemplateColumn Header="Estado" Width="Auto" MinWidth="95">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Abierto" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Exito}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Oficio.Cerrado}" Value="True">
                        <Setter Property="Text" Value="🔒 Cerrado" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.Advertencia}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Observaciones" Binding="{Binding Oficio.Observaciones}" Width="1.5*" MinWidth="160" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="3" Text="{Binding TituloDetalle}" Style="{StaticResource Texto.Seccion}" Margin="0,14,0,8" />

    <DataGrid Grid.Row="4" ItemsSource="{Binding Remisiones}" SelectedItem="{Binding RemisionSeleccionada}">
      <DataGrid.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding VerRemisionCommand}" CommandParameter="{Binding RemisionSeleccionada}" />
      </DataGrid.InputBindings>
      <DataGrid.Columns>
        <DataGridTextColumn Header="N° Remisión" Binding="{Binding Numero}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy'}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteODestino}" Width="*" MinWidth="200" />
        <DataGridTextColumn Header="Valor remisión" Binding="{Binding Total, StringFormat='$#,##0'}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource Celda.Derecha}" />
        <DataGridTextColumn Header="Recibo de caja" Binding="{Binding Recibo, TargetNullValue='-'}" Width="Auto" MinWidth="105" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource Celda.Centro}" />
      </DataGrid.Columns>
    </DataGrid>

    <WrapPanel Grid.Row="5" Margin="0,12,0,0">
      <Button Content="{Binding TextoCerrarAbrir}" Command="{Binding CerrarOAbrirCommand}" Padding="14,9" Margin="0,0,10,6" />
      <Button Content="✏ EDITAR OFICIO" Command="{Binding EditarOficioCommand}" Padding="14,9" Margin="0,0,10,6" />
      <Button Content="➕  AGREGAR REMISIÓN DE VENTA A ESTE OFICIO" Command="{Binding AgregarRemisionCommand}" Style="{StaticResource Boton.Primario}" Padding="15,9" Margin="0,0,10,6"
              ToolTip="Un oficio cerrado no admite remisiones nuevas: ábralo primero." />
    </WrapPanel>
  </Grid>
</UserControl>
