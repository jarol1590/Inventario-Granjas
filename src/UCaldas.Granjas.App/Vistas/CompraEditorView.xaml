<UserControl x:Class="UCaldas.Granjas.App.Vistas.CompraEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Etiq" TargetType="TextBlock" BasedOn="{StaticResource Texto.Etiqueta}">
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="26,18,26,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Encabezado de la factura -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Número Orden:" Style="{StaticResource Etiq}" />
      <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,28,10" Text="{Binding NumeroOrden, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EsLectura}" MaxLength="40" />
      <TextBlock Grid.Row="0" Grid.Column="2" Text="*Número Factura:" Style="{StaticResource Etiq}" />
      <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,10" Text="{Binding NumeroFactura, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EsLectura}" MaxLength="40"
               ToolTip="Identifica la compra; no se puede repetir." />

      <TextBlock Grid.Row="1" Text="*Fecha Compra:" Style="{StaticResource Etiq}" />
      <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,0,28,10" SelectedDate="{Binding FechaCompra, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding EsEditable}" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="*Granja Destino:" Style="{StaticResource Etiq}" />
      <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,10" ItemsSource="{Binding Granjas}" SelectedItem="{Binding GranjaSeleccionada}"
                DisplayMemberPath="Nombre" IsEnabled="{Binding EsEditable}" />

      <TextBlock Grid.Row="2" Text="*Proveedor / Entidad:" Style="{StaticResource Etiq}" />
      <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,28,10" Text="{Binding Proveedor, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EsLectura}" MaxLength="120" />
      <TextBlock Grid.Row="2" Grid.Column="2" Text="Nit:" Style="{StaticResource Etiq}" />
      <TextBox Grid.Row="2" Grid.Column="3" Margin="0,0,0,10" Text="{Binding Nit, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EsLectura}" MaxLength="30" />
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Observaciones:" Style="{StaticResource Etiq}" VerticalAlignment="Top" Margin="0,6,10,0" />
        <TextBox Grid.Column="1" Height="52" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                 Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EsLectura}" MaxLength="400" />
      </Grid>
      <Border Margin="0,10,0,0" Background="#FDECEA" BorderBrush="{StaticResource Brush.Peligro}" BorderThickness="1" CornerRadius="4" Padding="10,6"
              Visibility="{Binding Anulada, Converter={StaticResource BoolAVisibilidad}}">
        <TextBlock Text="COMPRA ANULADA: los animales ya no cuentan en el inventario ni en el Kardex." Foreground="{StaticResource Brush.Peligro}" FontWeight="SemiBold" />
      </Border>
    </StackPanel>

    <!-- Animales -->
    <Grid Grid.Row="2">
      <!-- Consulta (solo lectura) -->
      <DataGrid ItemsSource="{Binding Animales}" Margin="0,0,0,0" Visibility="{Binding EsEditable, Converter={StaticResource InvertirVisibilidad}}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Chapeta Amarilla" Binding="{Binding ChapetaAmarilla}" Width="1.2*" ElementStyle="{StaticResource Celda.Centro}" />
          <DataGridTextColumn Header="Chapeta Roja" Binding="{Binding ChapetaRoja, TargetNullValue='-'}" Width="1*" ElementStyle="{StaticResource Celda.Centro}" />
          <DataGridTextColumn Header="Sexo" Binding="{Binding Sexo}" Width="0.8*" ElementStyle="{StaticResource Celda.Centro}" />
          <DataGridTextColumn Header="Fecha Nacimiento" Binding="{Binding FechaNacimiento, StringFormat='dd/MM/yyyy'}" Width="1.2*" ElementStyle="{StaticResource Celda.Centro}" />
          <DataGridTextColumn Header="Raza" Binding="{Binding Raza}" Width="1*" ElementStyle="{StaticResource Celda.Centro}" />
          <DataGridTextColumn Header="Partos" Binding="{Binding NumeroPartos}" Width="0.6*" ElementStyle="{StaticResource Celda.Centro}" />
          <DataGridTextColumn Header="Peso (kg)" Binding="{Binding PesoKg, StringFormat='0.##'}" Width="0.8*" ElementStyle="{StaticResource Celda.Derecha}" />
          <DataGridTextColumn Header="Precio" Binding="{Binding PrecioFactura, StringFormat='$#,##0'}" Width="1.1*" ElementStyle="{StaticResource Celda.Derecha}" />
          <DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones, TargetNullValue='-'}" Width="1.5*" />
        </DataGrid.Columns>
      </DataGrid>

      <!-- Edición -->
      <DataGrid ItemsSource="{Binding Animales}" SelectedItem="{Binding FilaSeleccionada}" IsReadOnly="False" SelectionUnit="FullRow"
                Visibility="{Binding EsEditable, Converter={StaticResource BoolAVisibilidad}}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="*Chapeta Amarilla" Width="1.2*" MinWidth="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding ChapetaAmarilla, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Chapeta Roja" Width="1*" MinWidth="95">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding ChapetaRoja, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="*Sexo" Width="0.9*" MinWidth="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding DataContext.Sexos, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          SelectedItem="{Binding Sexo, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="*Fecha Nacimiento" Width="1.3*" MinWidth="135">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <DatePicker SelectedDate="{Binding FechaNacimiento, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="*Raza" Width="1.2*" MinWidth="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.Razas, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          Text="{Binding Raza, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="*Orientación" Width="1.2*" MinWidth="115">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding DataContext.Orientaciones, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          DisplayMemberPath="Nombre" SelectedValuePath="Id" SelectedValue="{Binding OrientacionId, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Partos" Width="0.6*" MinWidth="62">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding NumeroPartos, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center"
                         ToolTip="Solo hembras: define si le aplica la tarifa de vaca." />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Peso (kg)" Width="0.8*" MinWidth="75">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding PesoKg, StringFormat='0.##', UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="*Precio" Width="1.1*" MinWidth="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding PrecioFactura, StringFormat='#,##0', UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right"
                         ToolTip="Precio de la factura: queda como costo de origen del animal." />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="" Width="Auto">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="🗑 Quitar" Style="{StaticResource Boton.Enlace}" Foreground="{StaticResource Brush.Peligro}"
                        Command="{Binding DataContext.QuitarAnimalCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <Button Grid.Row="3" Margin="0,8,0,0" Content="+ Agregar Animal" Command="{Binding AgregarAnimalCommand}"
            Visibility="{Binding EsEditable, Converter={StaticResource BoolAVisibilidad}}" HorizontalAlignment="Stretch" />

    <Grid Grid.Row="4" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding CantidadTexto}" FontSize="15" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,30,0" />
        <TextBlock Text="Total" FontSize="15" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,0" />
        <Border Style="{StaticResource Tarjeta}" Padding="14,5" MinWidth="150">
          <TextBlock Text="{Binding TotalTexto}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Primario}" HorizontalAlignment="Right" />
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="✎ EDITAR COMPRA" Command="{Binding EditarCompraCommand}" Visibility="{Binding PuedeEditarODesechar, Converter={StaticResource BoolAVisibilidad}}" />
        <Button Margin="10,0,0,0" Content="⊘ ANULAR COMPRA" Command="{Binding AnularCommand}" Style="{StaticResource Boton.Peligro}"
                Visibility="{Binding PuedeEditarODesechar, Converter={StaticResource BoolAVisibilidad}}" />
        <Button Margin="10,0,0,0" Content="💾 GUARDAR" Command="{Binding GuardarCommand}" Style="{StaticResource Boton.Primario}"
                Visibility="{Binding EsEditable, Converter={StaticResource BoolAVisibilidad}}" />
        <Button Margin="10,0,0,0" Content="CANCELAR" Command="{Binding CancelarCommand}" IsCancel="True" MinWidth="100"
                Visibility="{Binding EsEditable, Converter={StaticResource BoolAVisibilidad}}" />
        <Button Margin="10,0,0,0" Content="CERRAR" Command="{Binding CancelarCommand}" MinWidth="100"
                Visibility="{Binding EsEditable, Converter={StaticResource InvertirVisibilidad}}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
