<UserControl x:Class="UCaldas.Granjas.App.Vistas.NuevoLoteView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Etiq" TargetType="TextBlock" BasedOn="{StaticResource Texto.Etiqueta}"><Setter Property="Margin" Value="0,0,10,10" /></Style>
  </UserControl.Resources>
  <StackPanel Margin="28,20,28,22">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <RadioButton GroupName="Entrada" Content="Compra a Proveedor" IsChecked="{Binding EsCompra}" Margin="0,0,24,0" />
      <RadioButton GroupName="Entrada" Content="Nacimiento / Cría Propia" IsChecked="{Binding EsNacimiento}" />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="*Código de lote:" Style="{StaticResource Etiq}" />
      <TextBox Grid.Column="1" Margin="0,0,20,10" Text="{Binding CodigoLote, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
      <TextBlock Grid.Column="2" Text="*Fecha ingreso:" Style="{StaticResource Etiq}" />
      <DatePicker Grid.Column="3" Margin="0,0,0,10" SelectedDate="{Binding FechaIngreso, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Grid.Row="1" Text="*Granja:" Style="{StaticResource Etiq}" />
      <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,20,10" ItemsSource="{Binding Granjas}" SelectedItem="{Binding GranjaSeleccionada}" DisplayMemberPath="Nombre" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="*Etapa inicial:" Style="{StaticResource Etiq}" />
      <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,10" ItemsSource="{Binding Etapas}" SelectedItem="{Binding EtapaSeleccionada}" DisplayMemberPath="Nombre" />
      <TextBlock Grid.Row="2" Text="*Ubicación:" Style="{StaticResource Etiq}" />
      <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,20,10" Text="{Binding Ubicacion, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" ToolTip="Galpón, estanque o corral" />
      <TextBlock Grid.Row="2" Grid.Column="2" Text="*Línea / raza:" Style="{StaticResource Etiq}" />
      <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,0,0,10" ItemsSource="{Binding RazasDisponibles}" SelectedItem="{Binding LineaRaza}" />
      <CheckBox Grid.Row="3" Grid.ColumnSpan="4" Margin="0,0,0,10" IsChecked="{Binding SinControlNumerico}"
                Content="Sin control numérico de población (p. ej. estanque piscícola: no se lleva conteo de individuos)" />
    </Grid>

    <Grid Visibility="{Binding LlevaConteo, Converter={StaticResource BoolAVisibilidad}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="*Cantidad inicial:" Style="{StaticResource Etiq}" />
      <TextBox Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,0,0,10" Text="{Binding Cantidad, UpdateSourceTrigger=LostFocus}" />
    </Grid>

    <!-- Compra -->
    <StackPanel Visibility="{Binding EsCompra, Converter={StaticResource BoolAVisibilidad}}">
      <TextBlock Text="Soporte de la compra" Style="{StaticResource Texto.Seccion}" Margin="0,4,0,10" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="*Factura / remisión:" Style="{StaticResource Etiq}" />
        <TextBox Grid.Column="1" Margin="0,0,20,10" Text="{Binding Factura, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
        <TextBlock Grid.Column="2" Text="*Orden de compra:" Style="{StaticResource Etiq}" />
        <TextBox Grid.Column="3" Margin="0,0,0,10" Text="{Binding OrdenCompra, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
        <TextBlock Grid.Row="1" Text="*Proveedor:" Style="{StaticResource Etiq}" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,20,10" Text="{Binding Proveedor, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="*Precio factura ($):" Style="{StaticResource Etiq}" ToolTip="Por cabeza; por el lote entero si no lleva conteo." />
        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,10" HorizontalContentAlignment="Right"
                 Text="{Binding PrecioUnitario, StringFormat='#,##0', UpdateSourceTrigger=LostFocus}" />
      </Grid>
    </StackPanel>

    <!-- Nacimiento -->
    <StackPanel Visibility="{Binding EsNacimiento, Converter={StaticResource BoolAVisibilidad}}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="Origen / referencia:" Style="{StaticResource Etiq}" />
        <TextBox Grid.Column="1" Margin="0,0,0,10" Text="{Binding OrigenReferencia, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                 ToolTip="Acta de incubación o parición, o chapeta de la madre (opcional)." />
      </Grid>
    </StackPanel>

    <Border Style="{StaticResource Tarjeta}" Padding="14,8" Margin="0,2,0,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Valor inicial:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,8,0" />
        <TextBlock Text="{Binding ValorInicialTexto}" VerticalAlignment="Center" Foreground="{StaticResource Brush.Primario}" FontWeight="Medium" />
      </StackPanel>
    </Border>
    <TextBlock Text="Observaciones:" Style="{StaticResource Etiq}" />
    <TextBox Height="48" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="💾 GUARDAR LOTE" Command="{Binding GuardarCommand}" Style="{StaticResource Boton.Primario}" IsDefault="True" />
      <Button Margin="10,0,0,0" Content="CANCELAR" Command="{Binding CancelarCommand}" IsCancel="True" MinWidth="100" />
    </StackPanel>
  </StackPanel>
</UserControl>