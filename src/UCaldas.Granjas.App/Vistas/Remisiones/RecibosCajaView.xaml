<UserControl x:Class="UCaldas.Granjas.App.Vistas.Remisiones.RecibosCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="➕  NUEVO RECIBO DE CAJA (SP)" Command="{Binding NuevoReciboCommand}" Style="{StaticResource Boton.Primario}" Padding="15,9" VerticalAlignment="Center"
              ToolTip="El recibo se genera al guardar una remisión." />
      <StackPanel>
        <TextBlock Text="Recibos de Caja Emitidos (consecutivo SP)" Style="{StaticResource Texto.Titulo}" />
        <TextBlock Text="Soporte de recaudo: 1 recibo SP por cada remisión de venta (subproductos, animales y lotes)." Style="{StaticResource Texto.Suave}" FontSize="12" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
      <Border Style="{StaticResource Tarjeta}" Margin="0,0,10,0" Padding="12,8">
        <StackPanel>
          <TextBlock Text="Recaudado por consignación" Style="{StaticResource Texto.KpiEtiqueta}" />
          <TextBlock Text="{Binding ConsignacionTexto}" Style="{StaticResource Texto.KpiValor}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tarjeta}" Margin="0,0,10,0" Padding="12,8">
        <StackPanel>
          <TextBlock Text="Recaudado en efectivo / cheque" Style="{StaticResource Texto.KpiEtiqueta}" />
          <TextBlock Text="{Binding EfectivoTexto}" Style="{StaticResource Texto.KpiValor}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tarjeta}" Padding="12,8">
        <StackPanel>
          <TextBlock Text="Último consecutivo emitido" Style="{StaticResource Texto.KpiEtiqueta}" />
          <TextBlock Text="{Binding UltimoTexto}" Style="{StaticResource Texto.KpiValor}" Foreground="{StaticResource Brush.Exito}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="Forma de pago:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="190" ItemsSource="{Binding Formas}" SelectedItem="{Binding Forma}" DisplayMemberPath="Nombre" Margin="0,0,20,0" />
      <TextBlock Text="🔍 Buscar:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Width="260" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" ToolTip="N° de recibo SP, remisión, oficio o cliente" />
      <CheckBox Margin="20,0,0,0" Content="Incluir anulados" IsChecked="{Binding IncluirAnulados}" VerticalAlignment="Center" />
    </StackPanel>

    <DataGrid Grid.Row="3" ItemsSource="{Binding Recibos}" SelectedItem="{Binding Seleccionado}">
      <DataGrid.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding AbrirReciboCommand}" CommandParameter="{Binding Seleccionado}" />
      </DataGrid.InputBindings>
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Recibo.Anulado}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Peligro}" />
              <Setter Property="ToolTip" Value="Recibo anulado" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Recibo No." Binding="{Binding Etiqueta}" Width="Auto" MinWidth="95" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Fecha" Binding="{Binding Recibo.Fecha, StringFormat='dd/MM/yyyy'}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Remisión" Binding="{Binding RemisionNumero}" Width="Auto" MinWidth="95" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Oficio" Binding="{Binding Oficio, TargetNullValue='N/A'}" Width="Auto" MinWidth="75" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Recibí de (cliente)" Binding="{Binding Cliente}" Width="*" MinWidth="180" />
        <DataGridTextColumn Header="Forma de pago" Binding="{Binding FormaPagoTexto}" Width="Auto" MinWidth="170" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Total pagado" Binding="{Binding Recibo.TotalPagado, StringFormat='$#,##0'}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource Celda.Derecha}" />
      </DataGrid.Columns>
    </DataGrid>

    <WrapPanel Grid.Row="4" Margin="0,12,0,0">
      <Button Content="👁  ABRIR / EDITAR RECIBO" Command="{Binding AbrirReciboCommand}" CommandParameter="{Binding Seleccionado}" Padding="14,9" Margin="0,0,10,6" />
      <Button Content="🖨  REIMPRIMIR RECIBO SP" Command="{Binding ReimprimirCommand}" Style="{StaticResource Boton.Primario}" Padding="15,9" Margin="0,0,10,6" />
    </WrapPanel>
  </Grid>
</UserControl>
