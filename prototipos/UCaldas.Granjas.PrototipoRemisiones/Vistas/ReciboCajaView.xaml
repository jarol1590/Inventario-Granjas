<UserControl x:Class="UCaldas.Granjas.PrototipoRemisiones.Vistas.ReciboCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel Margin="4">
    <!-- Encabezado y consecutivo automático -->
    <Border Background="{StaticResource Brush.Primario}" CornerRadius="6" Padding="15,12" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="RECIBO DE CAJA — FACULTAD DE CIENCIAS AGROPECUARIAS" Foreground="White" FontSize="15" FontWeight="Medium" />
          <TextBlock Text="Universidad de Caldas — Sistema Granja" Foreground="White" FontSize="12" Opacity="0.85" />
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource Brush.Arena}" CornerRadius="4" Padding="12,5" Margin="0,0,15,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Recibo No: " Foreground="{StaticResource Brush.Texto}" FontWeight="Medium" FontSize="14" />
            <TextBlock Text="829 SP" Foreground="{StaticResource Brush.Texto}" FontWeight="Medium" FontSize="15" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Fecha: " Foreground="White" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,6,0" />
          <DatePicker SelectedDate="2026-11-17" Width="130" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Remisión y pagador -->
    <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="160" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="* Remisión venta:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,0,8" />
        <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="0" Margin="0,0,15,8">
          <ComboBoxItem Content="REM-411 — Fruver ($ 420.000)" />
          <ComboBoxItem Content="REM-413 — Supermercados Mercaldas ($ 850.000)" />
        </ComboBox>
        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource Brush.InfoFondo}" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
          <TextBlock Text="Id Oficio: OF-124" Foreground="{StaticResource Brush.Primario}" FontWeight="Medium" HorizontalAlignment="Center" />
        </Border>

        <TextBlock Grid.Row="1" Text="Recibí de:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="FRUVER (NIT: 900.412.889-1)" IsReadOnly="True" FontWeight="Medium" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Text="La suma de:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="CUATROCIENTOS VEINTE MIL PESOS M/CTE" IsReadOnly="True" FontWeight="Medium" />
      </Grid>
    </Border>

    <!-- Detalle heredado de la remisión -->
    <Border Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,0,12">
      <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="30" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Brush.PrimarioClaro}" CornerRadius="5,5,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="h0" /><ColumnDefinition Width="*" MinWidth="240" /><ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="h2" />
              <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="h3" /><ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="h4" /><ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="h5" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Código" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="1" Text="Detalle" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="2" Text="Unidad" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="3" Text="Valor unitario" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="4" Text="Cantidad" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="5" Text="Valor total" Style="{StaticResource Encab}" />
          </Grid>
        </Border>
        <StackPanel Grid.Row="1">
          <Border BorderBrush="{StaticResource Brush.BordeSuave}" BorderThickness="0,0,0,1" Padding="0,7">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="h0" /><ColumnDefinition Width="*" MinWidth="240" /><ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="h2" />
                <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="h3" /><ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="h4" /><ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="h5" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="HOR-04" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="1" Text="Tomate Chonto Primera Calidad" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="2" Text="Kg" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="3" Text="$ 3.000" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="4" Text="100" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="5" Text="$ 300.000" Style="{StaticResource CelNegrita}" />
            </Grid>
          </Border>
          <Border BorderBrush="{StaticResource Brush.BordeSuave}" BorderThickness="0,0,0,1" Padding="0,7">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="h0" /><ColumnDefinition Width="*" MinWidth="240" /><ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="h2" />
                <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="h3" /><ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="h4" /><ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="h5" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="HOR-09" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="1" Text="Lechuga Batavia Hidropónica" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="2" Text="Unidad" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="3" Text="$ 2.000" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="4" Text="60" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="5" Text="$ 120.000" Style="{StaticResource CelNegrita}" />
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Forma de pago y totales -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="Forma de pago" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,10" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton Content="Consignación bancaria" GroupName="FormaPago" IsChecked="True" FontWeight="Medium" Margin="0,0,20,0" />
            <RadioButton Content="Cheque - Efectivo" GroupName="FormaPago" FontWeight="Medium" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Foreground="{StaticResource Brush.Texto}" Text="Entidad bancaria:" Width="115" VerticalAlignment="Center" />
            <ComboBox Width="290" SelectedIndex="0">
              <ComboBoxItem Content="DAVIVIENDA — CTA AHORROS 084500007533" />
              <ComboBoxItem Content="BANCOLOMBIA" />
              <ComboBoxItem Content="BANCO DE BOGOTÁ" />
            </ComboBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <CheckBox Content="Efectivo" VerticalAlignment="Center" Margin="0,0,15,0" />
            <TextBlock Foreground="{StaticResource Brush.Texto}" Text="Cheque 1:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox Width="90" Margin="0,0,12,0" />
            <TextBlock Foreground="{StaticResource Brush.Texto}" Text="Cheque 2:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox Width="90" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" /><ColumnDefinition Width="150" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Text="Subtotal:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,0,8" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="$ 420.000" IsReadOnly="True" HorizontalContentAlignment="Right" Margin="0,0,0,8" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="Descuento (%): " Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" />
            <TextBox Text="0,00" Width="60" HorizontalContentAlignment="Right" />
          </StackPanel>
          <TextBox Grid.Row="1" Grid.Column="1" Text="$ 0" IsReadOnly="True" HorizontalContentAlignment="Right" Margin="0,0,0,8" />
          <TextBlock Grid.Row="2" Text="TOTAL RECIBO:" FontSize="15" FontWeight="Medium" Foreground="{StaticResource Brush.Primario}" VerticalAlignment="Center" />
          <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Brush.AvisoFondo}" BorderBrush="{StaticResource Brush.Arena}" BorderThickness="1" CornerRadius="4" Padding="8,5">
            <TextBlock Text="$ 420.000" FontSize="16" FontWeight="Medium" Foreground="{StaticResource Brush.Primario}" HorizontalAlignment="Right" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <DockPanel Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="💾  GUARDAR E IMPRIMIR RECIBO" Style="{StaticResource Boton.Primario}" Padding="16,10" Margin="0,0,10,0" />
        <Button Content="CANCELAR" Padding="14,10" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Observaciones:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Width="340" Text="Consignación verificada en soporte bancario adjunto." />
      </StackPanel>
    </DockPanel>
  </StackPanel>
</UserControl>
