<UserControl x:Class="UCaldas.Granjas.PrototipoRemisiones.Vistas.NuevaRemisionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Margin="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Encabezado de la ventana modal -->
    <Border Grid.Row="0" Background="{StaticResource Brush.Primario}" CornerRadius="6" Padding="15,10" Margin="0,0,0,12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="N° REM-413 (automático)" Foreground="White" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
        <TextBlock Text="REGISTRO DE REMISIÓN  ·  ventana «Nueva remisión»" Foreground="White" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Tipo, oficio, programa, fecha -->
    <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock Text="Tipo de remisión:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,16,0" />
          <RadioButton Content="Venta (requiere oficio y recibo de caja)" GroupName="TipoRemision" IsChecked="True" FontWeight="Medium" Margin="0,0,22,0" VerticalContentAlignment="Center" />
          <RadioButton Content="Traslado entre granjas (sin oficio)" GroupName="TipoRemision" FontWeight="Medium" Margin="0,0,22,0" VerticalContentAlignment="Center" />
          <RadioButton Content="Compra a proveedor (sin oficio)" GroupName="TipoRemision" FontWeight="Medium" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
          <TextBlock Text="* Oficio de venta asociado" Style="{StaticResource Campo.Etiqueta}" />
          <ComboBox SelectedIndex="1">
            <ComboBoxItem Content="OF-123 (Ganado Lácteo)" />
            <ComboBoxItem Content="OF-124 (Hortalizas Clima Frío)" />
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0">
          <TextBlock Text="Programa (heredado del oficio)" Style="{StaticResource Campo.Etiqueta}" />
          <TextBox Text="Hortalizas Clima Frío" IsReadOnly="True" FontWeight="Medium" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,0,0,0">
          <TextBlock Text="* Fecha de remisión" Style="{StaticResource Campo.Etiqueta}" />
          <DatePicker SelectedDate="2026-11-17" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Origen y cliente -->
    <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
          <TextBlock Text="* Granja origen" Style="{StaticResource Campo.Etiqueta}" />
          <ComboBox SelectedIndex="0">
            <ComboBoxItem Content="Granja Tesorito" />
            <ComboBoxItem Content="Granja Montelindo" />
            <ComboBoxItem Content="Granja La Cruz" />
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="5,0">
          <TextBlock Text="* Cliente / destinatario" Style="{StaticResource Campo.Etiqueta}" />
          <ComboBox SelectedIndex="0" IsEditable="True">
            <ComboBoxItem Content="Fruver" />
            <ComboBoxItem Content="Agropecuaria El Ruiz" />
            <ComboBoxItem Content="Supermercados Mercaldas" />
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="10,0,0,0">
          <TextBlock Text="NIT / Cédula" Style="{StaticResource Campo.Etiqueta}" />
          <TextBox Text="900.412.889-1" IsReadOnly="True" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Detalle -->
    <Border Grid.Row="3" Style="{StaticResource Tarjeta}" VerticalAlignment="Top">
      <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="32" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Content="➕ Agregar producto / animal" Style="{StaticResource Boton.Primario}" Padding="12,5" />
          <TextBlock Text="Detalle de productos / semovientes" Style="{StaticResource Texto.Seccion}" VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource Brush.PrimarioClaro}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="d0" />
              <ColumnDefinition Width="*" MinWidth="240" />
              <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="d2" />
              <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="d3" />
              <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="d4" />
              <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="d5" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Código" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="1" Text="Descripción del ítem" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="2" Text="Unidad" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="3" Text="Cantidad" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="4" Text="Valor unitario" Style="{StaticResource Encab}" />
            <TextBlock Grid.Column="5" Text="Valor total" Style="{StaticResource Encab}" />
          </Grid>
        </Border>

        <StackPanel Grid.Row="2">
          <Border BorderBrush="{StaticResource Brush.BordeSuave}" BorderThickness="0,0,0,1" Padding="0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="d0" />
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="d2" />
                <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="d3" />
                <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="d4" />
                <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="d5" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="HOR-04" Style="{StaticResource CelNegrita}" />
              <TextBlock Grid.Column="1" Text="Tomate Chonto Primera Calidad" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="2" Text="Kg" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="3" Text="100" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="4" Text="$ 3.000" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="5" Text="$ 300.000" Style="{StaticResource CelNegrita}" />
            </Grid>
          </Border>
          <Border BorderBrush="{StaticResource Brush.BordeSuave}" BorderThickness="0,0,0,1" Padding="0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="d0" />
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="d2" />
                <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="d3" />
                <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="d4" />
                <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="d5" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="HOR-09" Style="{StaticResource CelNegrita}" />
              <TextBlock Grid.Column="1" Text="Lechuga Batavia Hidropónica" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="2" Text="Unidad" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="3" Text="60" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="4" Text="$ 2.000" Style="{StaticResource Cel}" />
              <TextBlock Grid.Column="5" Text="$ 120.000" Style="{StaticResource CelNegrita}" />
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
          <TextBlock Foreground="{StaticResource Brush.Texto}" Text="Total remisión:" FontSize="15" FontWeight="Medium" Margin="0,0,14,0" VerticalAlignment="Center" />
          <TextBlock Text="$ 420.000" FontSize="17" FontWeight="Medium" Foreground="{StaticResource Brush.Exito}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="💾  GUARDAR REMISIÓN" Style="{StaticResource Boton.Primario}" Padding="18,10" Margin="0,0,10,0" />
      <Button Content="CANCELAR" Padding="16,10" />
    </StackPanel>
  </Grid>
</UserControl>
