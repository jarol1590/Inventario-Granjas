<UserControl x:Class="UCaldas.Granjas.App.Vistas.Remisiones.DatosInstitucionalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,12,12">
      <TextBlock Text="Datos que aparecen en las remisiones y recibos de caja, y consecutivo de recibos SP." Style="{StaticResource Texto.Suave}" Margin="0,0,0,12" />
      <Border Style="{StaticResource Tarjeta}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Director(a) de Granjas:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,10" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Margin="0,0,20,10" Text="{Binding NombreDirector, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />
          <TextBlock Grid.Column="2" Text="Cargo:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,10" VerticalAlignment="Center" />
          <TextBox Grid.Column="3" Margin="0,0,0,10" Text="{Binding CargoDirector, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />
          <TextBlock Grid.Row="1" Text="Título:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,10" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,20,10" Text="{Binding TituloDirector, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="Jefe de Tesorería:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,10" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,10" Text="{Binding JefeTesoreria, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />
          <TextBlock Grid.Row="2" Text="Facultad / Departamento:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,10" VerticalAlignment="Center" />
          <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,10" Text="{Binding FacultadDepto, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />
          <TextBlock Grid.Row="3" Text="Teléfonos:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,10" VerticalAlignment="Center" />
          <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,20,10" Text="{Binding Telefonos, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" />
          <TextBlock Grid.Row="3" Grid.Column="2" Text="Extensiones:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,10" VerticalAlignment="Center" />
          <TextBox Grid.Row="3" Grid.Column="3" Margin="0,0,0,10" Text="{Binding Extensiones, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" />
          <TextBlock Grid.Row="4" Text="Entidad bancaria:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,10" VerticalAlignment="Center" />
          <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,20,10" Text="{Binding EntidadBancaria, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" />
          <TextBlock Grid.Row="4" Grid.Column="2" Text="Tipo de cuenta:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,10" VerticalAlignment="Center" />
          <TextBox Grid.Row="4" Grid.Column="3" Margin="0,0,0,10" Text="{Binding TipoCuenta, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
          <TextBlock Grid.Row="5" Text="Número de cuenta:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,0" VerticalAlignment="Center" />
          <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,20,0" Text="{Binding NumeroCuenta, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
          <TextBlock Grid.Row="5" Grid.Column="2" Text="Último consecutivo SP:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,0" VerticalAlignment="Center"
                     ToolTip="El siguiente recibo será este número más uno." />
          <TextBox Grid.Row="5" Grid.Column="3" HorizontalContentAlignment="Right" Text="{Binding UltimoConsecutivo, UpdateSourceTrigger=LostFocus}" />
        </Grid>
      </Border>
      <Button Content="💾 GUARDAR DATOS" Command="{Binding GuardarCommand}" Style="{StaticResource Boton.Primario}" Padding="16,10" Margin="0,14,0,0" HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
