<Project>

  <!-- Gestión central de versiones de paquetes NuGet. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Datos -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Dapper" Version="2.1.89" />

    <!-- Servicios / reportes -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />

    <!-- Presentación -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />

    <!-- Pruebas. FluentAssertions se fija en 7.2.0: la serie 8.x exige licencia de pago para uso comercial. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
  </ItemGroup>

</Project>
