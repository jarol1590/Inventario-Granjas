<UserControl x:Class="UCaldas.Granjas.App.Vistas.Configuracion.ConfigurarRecuperacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:UCaldas.Granjas.App.Infraestructura">
  <StackPanel Margin="26,20,26,22">
    <!-- Paso 1: contraseña actual, pregunta y respuesta -->
    <StackPanel Visibility="{Binding MuestraFormulario, Converter={StaticResource BoolAVisibilidad}}"
                infra:FocoAlMostrarse.Activo="True" infra:FocoAlMostrarse.Destino="{Binding ElementName=CampoContrasenaActual}">
      <TextBlock Style="{StaticResource Texto.Suave}"
                 Text="Elija una pregunta secreta y su respuesta. El sistema generará una clave de recuperación nueva (la anterior, si existía, dejará de servir). Con cualquiera de las dos podrá restablecer la contraseña sin perder datos." />

      <TextBlock Text="Contraseña actual" Style="{StaticResource Texto.Etiqueta}" Margin="0,14,0,4" />
      <PasswordBox x:Name="CampoContrasenaActual" AutomationProperties.Name="Contraseña actual"
                   infra:ContrasenaAsistente.Contrasena="{Binding ContrasenaActual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Text="Pregunta secreta" Style="{StaticResource Texto.Etiqueta}" Margin="0,12,0,4" />
      <ComboBox ItemsSource="{Binding Preguntas}" SelectedItem="{Binding PreguntaSecreta}" AutomationProperties.Name="Pregunta secreta" />

      <TextBlock Text="Respuesta secreta" Style="{StaticResource Texto.Etiqueta}" Margin="0,12,0,4" />
      <TextBox Text="{Binding Respuesta, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Respuesta secreta" />
      <TextBlock Margin="0,4,0,0" Style="{StaticResource Texto.Suave}"
                 Text="No importan las mayúsculas, las tildes ni los espacios de más." />

      <TextBlock Margin="0,12,0,0" Text="{Binding MensajeError}" Style="{StaticResource Texto.Error}"
                 Visibility="{Binding MensajeError, Converter={StaticResource NuloAVisibilidad}}" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="GENERAR CLAVE DE RECUPERACIÓN" Command="{Binding GenerarCommand}" Style="{StaticResource Boton.Primario}" IsDefault="True" />
        <Button Margin="10,0,0,0" Content="Cancelar" Command="{Binding CancelarCommand}" IsCancel="True" MinWidth="100" />
      </StackPanel>
    </StackPanel>

    <!-- Paso 2: la clave -->
    <StackPanel Visibility="{Binding MuestraClave, Converter={StaticResource BoolAVisibilidad}}">
      <ContentControl Content="{Binding Clave}" IsTabStop="False" />
      <Button Margin="0,16,0,0" Content="LISTO" Command="{Binding ListoCommand}" Style="{StaticResource Boton.Primario}"
              HorizontalAlignment="Right" MinWidth="120" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</UserControl>
