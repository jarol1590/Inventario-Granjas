<UserControl x:Class="UCaldas.Granjas.App.Vistas.Configuracion.FirmasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <Grid Margin="0,0,12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,24,0">
          <TextBlock Text="INFORMACIÓN DE LA AUTORIDAD FIRMANTE" Style="{StaticResource Texto.Titulo}" />

          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="*Nombre de la Autoridad:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Text="{Binding NombreAutoridad, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Text="*Cargo:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Cargo, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="2" Text="*Nombre Departamento:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Departamento, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="3" Text="Teléfono:" Style="{StaticResource Texto.Etiqueta}" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>

          <TextBlock Margin="0,28,0,10" Text="IMAGEN DE LA FIRMA DIGITALIZADA (FORMATO TRANSPARENTE PNG / JPG)"
                     Style="{StaticResource Texto.Seccion}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal">
            <Border Width="300" Height="100" Style="{StaticResource Tarjeta}" Padding="4">
              <Grid>
                <Image Source="{Binding ImagenVista}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Imagen de la firma manuscrita" Style="{StaticResource Texto.Suave}" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ImagenVista, Converter={StaticResource NuloAVisibilidad}, ConverterParameter=invertir}" />
              </Grid>
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Top">
              <Button Content="📂 Cargar Nueva Imagen" Command="{Binding CargarImagenCommand}" />
              <TextBlock Margin="0,8,0,0" Text="· Tamaño sugerido: 300 x 100 px" Style="{StaticResource Texto.Suave}" />
              <TextBlock Text="· La firma aparecerá incrustada sobre la línea de texto" Style="{StaticResource Texto.Suave}" MaxWidth="260" />
              <Button Margin="0,10,0,0" Content="🗑 Quitar Firma" Command="{Binding QuitarFirmaCommand}" Style="{StaticResource Boton.Peligro}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Vista previa del bloque de firma de los informes -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" VerticalAlignment="Top" Padding="20">
          <StackPanel>
            <TextBlock Text="Así saldrá en los informes" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,14" />
            <Grid Height="86" Margin="0,0,0,0">
              <Image Source="{Binding ImagenVista}" Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <Border BorderBrush="{StaticResource Brush.Texto}" BorderThickness="0,1,0,0" Margin="0,-6,0,6" Width="260" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding NombreAutoridad}" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Cargo}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Departamento}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Telefono, StringFormat='Tel: {0}'}" Style="{StaticResource Texto.Suave}"
                       Visibility="{Binding Telefono, Converter={StaticResource NuloAVisibilidad}}" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <Button Grid.Row="1" HorizontalAlignment="Right" Margin="0,14,12,0" Content="💾 GUARDAR CONFIGURACIÓN"
            Command="{Binding GuardarCommand}" Style="{StaticResource Boton.Primario}" />
  </Grid>
</UserControl>
