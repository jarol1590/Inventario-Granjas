<UserControl x:Class="UCaldas.Granjas.App.Vistas.BovinosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Gestión de Bovinos" Style="{StaticResource Texto.Titulo}" />

    <!-- Filtros -->
    <WrapPanel Grid.Row="1" Margin="0,10,0,10">
      <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
        <TextBlock Text="Buscar por ID" Style="{StaticResource Texto.Etiqueta}" FontSize="14" Margin="0,0,8,0" />
        <Grid Width="190">
          <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Chapeta amarilla, chapeta roja o nombre" />
          <TextBlock Text="🔍 Buscar" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                     Foreground="{StaticResource Brush.TextoSuave}"
                     Visibility="{Binding Texto, Converter={StaticResource NuloAVisibilidad}, ConverterParameter=invertir}" />
        </Grid>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
        <TextBlock Text="Orientación" Style="{StaticResource Texto.Etiqueta}" FontSize="14" Margin="0,0,8,0" />
        <ComboBox Width="130" ItemsSource="{Binding Orientaciones}" SelectedItem="{Binding OrientacionSeleccionada}" DisplayMemberPath="Nombre" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
        <TextBlock Text="Estado" Style="{StaticResource Texto.Etiqueta}" FontSize="14" Margin="0,0,8,0" />
        <ComboBox Width="120" ItemsSource="{Binding Estados}" SelectedItem="{Binding EstadoSeleccionado}" DisplayMemberPath="Nombre" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
        <TextBlock Text="Sexo" Style="{StaticResource Texto.Etiqueta}" FontSize="14" Margin="0,0,8,0" />
        <ComboBox Width="100" ItemsSource="{Binding Sexos}" SelectedItem="{Binding SexoSeleccionado}" DisplayMemberPath="Nombre" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <TextBlock Text="Categoría" Style="{StaticResource Texto.Etiqueta}" FontSize="14" Margin="0,0,8,0" />
        <ComboBox Width="150" ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSeleccionada}" DisplayMemberPath="Nombre" />
      </StackPanel>
    </WrapPanel>

    <!-- Tabla -->
    <DataGrid Grid.Row="2" ItemsSource="{Binding Bovinos}" SelectedItem="{Binding Seleccionado}">
      <DataGrid.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding AbrirFichaCommand}" CommandParameter="{Binding Seleccionado}" />
      </DataGrid.InputBindings>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Chapeta Amarilla" Binding="{Binding ChapetaAmarilla}" Width="1.2*" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Chapeta Roja" Binding="{Binding ChapetaRoja, TargetNullValue='-'}" Width="1.1*" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Granja" Binding="{Binding GranjaNombre}" Width="1*" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Sexo" Binding="{Binding Sexo}" Width="0.8*" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Orientación" Binding="{Binding Orientacion}" Width="1*" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTemplateColumn Header="Categoría" Width="1.3*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Categoria}" HorizontalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SinTarifa}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Advertencia}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="ToolTip" Value="La matriz de tarifas vigente no cubre la edad, sexo u orientación de este animal. Revise Configuración › Tarifas." />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Edad en meses" Binding="{Binding EdadMeses}" Width="0.9*" MinWidth="125" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Valor" Binding="{Binding ValorContable, StringFormat='$#,##0'}" Width="1.1*" ElementStyle="{StaticResource Celda.Derecha}" />
        <DataGridTemplateColumn Header="Valorización" Width="1.1*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Valorizacion, StringFormat='+$#,##0;-$#,##0;-'}" HorizontalAlignment="Right"
                         Foreground="{Binding Valorizacion, Converter={StaticResource SignoABrocha}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Pie: conteo y total -->
    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding ResumenTexto}" FontSize="16" Style="{StaticResource Texto.Etiqueta}" />
        <Button Margin="18,0,0,0" Content="🪪 Ver ficha técnica" Command="{Binding AbrirFichaCommand}" CommandParameter="{Binding Seleccionado}"
                ToolTip="También puede abrirla con doble clic sobre el animal." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <TextBlock Text="Total" FontSize="16" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,0" />
        <Border Style="{StaticResource Tarjeta}" Padding="14,6" MinWidth="150" ToolTip="Valor contable de los bovinos mostrados">
          <TextBlock Text="{Binding TotalTexto}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Brush.Primario}"
                     HorizontalAlignment="Right" />
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
