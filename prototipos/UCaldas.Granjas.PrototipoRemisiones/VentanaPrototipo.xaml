<Window x:Class="UCaldas.Granjas.PrototipoRemisiones.VentanaPrototipo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:UCaldas.Granjas.PrototipoRemisiones.Vistas"
        Title="PROTOTIPO — Módulo Remisiones, Oficios y Recibos de Caja"
        FontFamily="{StaticResource Fuente.Base}"
        Width="1220" Height="880" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Fondo}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Cabecera institucional -->
    <Border Grid.Row="0" Background="White" Padding="16,8">
      <DockPanel>
        <Image DockPanel.Dock="Left" Source="/Recursos/Imagenes/LogoUniversidadDeCaldas.png" Height="52" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Logo de la Universidad de Caldas" />
        <Border DockPanel.Dock="Right" Background="{StaticResource Brush.AvisoFondo}" BorderBrush="{StaticResource Brush.Advertencia}"
                BorderThickness="1" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
          <TextBlock Text="PROTOTIPO · datos de ejemplo · no guarda nada" Foreground="{StaticResource Brush.Advertencia}" FontWeight="Medium" />
        </Border>
        <TextBlock Text="Sistema Unificado de Gestión de Granjas — Maqueta de Remisiones" Style="{StaticResource Texto.Titulo}"
                   VerticalAlignment="Center" Margin="24,0" />
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Height="4" Background="{StaticResource Brush.DegradadoFacultad}" />

    <TabControl Grid.Row="2" Style="{StaticResource Tab.Segmentado}" Margin="16,12,16,12">
      <TabItem Header="1 · Remisiones">
        <v:RemisionesView />
      </TabItem>
      <TabItem Header="2 · Oficios">
        <v:OficiosView />
      </TabItem>
      <TabItem Header="3 · Nuevo oficio">
        <v:NuevoOficioView />
      </TabItem>
      <TabItem Header="4 · Nueva remisión">
        <v:NuevaRemisionView />
      </TabItem>
      <TabItem Header="5 · Detalle de remisión">
        <v:DetalleRemisionView />
      </TabItem>
      <TabItem Header="6 · Recibos de caja">
        <v:RecibosCajaView />
      </TabItem>
      <TabItem Header="7 · Recibo de caja">
        <v:ReciboCajaView />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
