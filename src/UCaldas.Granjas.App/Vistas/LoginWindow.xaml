<Window x:Class="UCaldas.Granjas.App.Vistas.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:UCaldas.Granjas.App.Infraestructura"
        Title="Inventario Sistema Granjas"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Fondo}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=CampoContrasena}">
  <Border Margin="28" Style="{StaticResource Tarjeta}" Padding="28">
    <StackPanel>
      <!-- Marcador del logo institucional (el escudo oficial se coloca aquí cuando esté disponible). -->
      <Border Width="84" Height="84" HorizontalAlignment="Center" BorderBrush="{StaticResource Brush.Primario}"
              BorderThickness="2" CornerRadius="42" Background="{StaticResource Brush.Primario}">
        <TextBlock Text="UC" Foreground="White" FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <TextBlock Margin="0,16,0,0" Text="Sistema Unificado de Gestión de Granjas" Style="{StaticResource Texto.Titulo}"
                 TextAlignment="Center" TextWrapping="Wrap" />
      <TextBlock Margin="0,4,0,0" Text="Universidad de Caldas · Facultad de Ciencias Agropecuarias"
                 Style="{StaticResource Texto.Suave}" TextAlignment="Center" />

      <TextBlock Margin="0,22,0,10" Text="{Binding Instruccion}" Style="{StaticResource Texto.Suave}" />

      <TextBlock Text="Contraseña" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,4" />
      <PasswordBox x:Name="CampoContrasena" infra:ContrasenaAsistente.Contrasena="{Binding Contrasena, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

      <StackPanel Visibility="{Binding EsPrimerArranque, Converter={StaticResource BoolAVisibilidad}}">
        <TextBlock Text="Confirme la contraseña" Style="{StaticResource Texto.Etiqueta}" Margin="0,12,0,4" />
        <PasswordBox infra:ContrasenaAsistente.Contrasena="{Binding Confirmacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,6,0,0" Style="{StaticResource Texto.Suave}"
                   Text="{Binding LongitudMinima, StringFormat='Mínimo {0} caracteres.'}" />
      </StackPanel>

      <TextBlock Margin="0,12,0,0" Text="{Binding MensajeError}" Style="{StaticResource Texto.Error}"
                 Visibility="{Binding MensajeError, Converter={StaticResource NuloAVisibilidad}}" />

      <Button Margin="0,18,0,0" Content="{Binding TextoBoton}" Command="{Binding AceptarCommand}"
              Style="{StaticResource Boton.Primario}" IsDefault="True" Padding="14,10" />
    </StackPanel>
  </Border>
</Window>
