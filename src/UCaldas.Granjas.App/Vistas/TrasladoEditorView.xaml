<UserControl x:Class="UCaldas.Granjas.App.Vistas.TrasladoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:UCaldas.Granjas.App.Infraestructura">
  <UserControl.Resources>
    <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
    <Style x:Key="Etiq" TargetType="TextBlock" BasedOn="{StaticResource Texto.Etiqueta}">
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="26,18,26,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Datos Generales" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,10" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="*Granja Origen:" Style="{StaticResource Etiq}" />
        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,28,10" ItemsSource="{Binding Granjas}" SelectedItem="{Binding GranjaOrigen}" DisplayMemberPath="Nombre"
                  IsEnabled="{Binding PuedeCambiarOrigen}"
                  ToolTip="La granja de origen no se puede cambiar en un traslado ya registrado: anúlelo y regístrelo de nuevo." />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="*Granja Destino:" Style="{StaticResource Etiq}" />
        <ComboBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,10" ItemsSource="{Binding Granjas}" SelectedItem="{Binding GranjaDestino}" DisplayMemberPath="Nombre"
                  IsEnabled="{Binding EsEditable}" />

        <TextBlock Grid.Row="1" Text="*Fecha Traslado:" Style="{StaticResource Etiq}" />
        <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,0,28,10" SelectedDate="{Binding FechaTraslado, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding EsEditable}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="*N° Remisión:" Style="{StaticResource Etiq}" />
        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,10" Text="{Binding NumeroRemision, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EsLectura}" MaxLength="40" />

        <TextBlock Grid.Row="2" Text="Observaciones:" Style="{StaticResource Etiq}" VerticalAlignment="Top" Margin="0,6,10,0" />
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="48" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                 Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EsLectura}" MaxLength="400" />
      </Grid>

      <Border Margin="0,10,0,0" Background="#FDECEA" BorderBrush="{StaticResource Brush.Peligro}" BorderThickness="1" CornerRadius="4" Padding="10,6"
              Visibility="{Binding Anulado, Converter={StaticResource BoolAVisibilidad}}">
        <TextBlock Text="TRASLADO ANULADO: los animales o lotes regresaron a la granja de origen." Foreground="{StaticResource Brush.Peligro}" FontWeight="Medium" />
      </Border>

      <!-- Solo al crear o editar: búsqueda y selección de animales -->
      <StackPanel Visibility="{Binding MostrarSeleccionLotes, Converter={StaticResource BoolAVisibilidad}}">
        <TextBlock Text="Selección de Lotes a Trasladar" Style="{StaticResource Texto.Seccion}" Margin="0,18,0,10" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox ItemsSource="{Binding LotesDisponibles}" SelectedItem="{Binding LoteParaAgregar}" DisplayMemberPath="Codigo" ToolTip="Lotes activos de la granja de origen." />
          <Button Grid.Column="1" Margin="10,0,0,0" Content="+ Agregar Lote" Command="{Binding AgregarLoteCommand}" MinWidth="150" />
        </Grid>
      </StackPanel>

      <StackPanel Visibility="{Binding MostrarSeleccionAnimales, Converter={StaticResource BoolAVisibilidad}}">
        <TextBlock Text="Selección de Animales a Trasladar" Style="{StaticResource Texto.Seccion}" Margin="0,18,0,10" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Buscar:" Style="{StaticResource Etiq}" />
          <Grid Width="280" Margin="0,0,12,0">
            <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding AgregarALaListaCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="🔍 Animal en Granja Origen" Style="{StaticResource Texto.Marcador}" Margin="9,0,0,10"
                       Visibility="{Binding TextoBusqueda, Converter={StaticResource NuloAVisibilidad}, ConverterParameter=invertir}" />
          </Grid>
          <Button Content="+ Agregar a la Lista" Command="{Binding AgregarALaListaCommand}" VerticalAlignment="Top" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="Lista de Animales Seleccionados" Style="{StaticResource Texto.Seccion}" Margin="0,4,0,8" />

    <!-- Lotes (traslado de un programa por lotes): la misma pantalla con una grilla de lotes -->
    <DataGrid Grid.Row="2" ItemsSource="{Binding Lotes}" IsReadOnly="False" SelectionUnit="FullRow"
              Visibility="{Binding EsLote, Converter={StaticResource BoolAVisibilidad}}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código Lote" Binding="{Binding Codigo}" Width="1.1*" MinWidth="105" IsReadOnly="True" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Etapa" Binding="{Binding Etapa}" Width="1*" MinWidth="85" IsReadOnly="True" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTemplateColumn Header="Cantidad" Width="0.9*" MinWidth="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right" IsEnabled="{Binding ControlNumerico}"
                       IsReadOnly="{Binding Data.EsLectura, Source={StaticResource Proxy}}" ToolTip="Cabezas a mover; si son menos que las del lote se crea un lote nuevo en el destino." />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Código lote nuevo" Width="1.2*" MinWidth="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding CodigoNuevoLote, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" IsEnabled="{Binding EsParcial}"
                       IsReadOnly="{Binding Data.EsLectura, Source={StaticResource Proxy}}" ToolTip="Obligatorio en un traslado parcial." />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Ubicación destino" Width="1.2*" MinWidth="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding UbicacionDestino, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                       IsReadOnly="{Binding Data.EsLectura, Source={StaticResource Proxy}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Valor en libros" Binding="{Binding Valor, StringFormat='$#,##0'}" Width="1.1*" MinWidth="105" IsReadOnly="True" ElementStyle="{StaticResource Celda.Derecha}" />
        <DataGridTemplateColumn Header="Acciones" Width="105">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="🗑 Quitar" Style="{StaticResource Boton.Enlace}" Foreground="{StaticResource Brush.Peligro}"
                      Visibility="{Binding Data.EsEditable, Source={StaticResource Proxy}, Converter={StaticResource BoolAVisibilidad}}"
                      Command="{Binding DataContext.QuitarLoteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <DataGrid Grid.Row="2" Visibility="{Binding EsIndividual, Converter={StaticResource BoolAVisibilidad}}" ItemsSource="{Binding Animales}" SelectedItem="{Binding FilaSeleccionada}" IsReadOnly="False" SelectionUnit="FullRow">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Chapeta Amarilla" Binding="{Binding Animal.ChapetaAmarilla}" Width="1.2*" MinWidth="132" IsReadOnly="True" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Orientación Origen" Binding="{Binding Animal.Orientacion}" Width="1.2*" MinWidth="150" IsReadOnly="True" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTemplateColumn Header="Orientación Destino" Width="1.4*" MinWidth="140">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.Orientaciones, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        DisplayMemberPath="Nombre" SelectedValuePath="Id" SelectedValue="{Binding OrientacionDestinoId, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding Data.EsEditable, Source={StaticResource Proxy}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Sexo" Binding="{Binding Animal.Sexo}" Width="0.8*" IsReadOnly="True" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Fecha Nacimiento" Binding="{Binding Animal.FechaNacimiento, StringFormat='dd/MM/yyyy'}" Width="1.2*" MinWidth="140" IsReadOnly="True" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Raza" Binding="{Binding Animal.Raza}" Width="1*" IsReadOnly="True" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Precio" Binding="{Binding Animal.ValorContable, StringFormat='$#,##0'}" Width="1.1*" IsReadOnly="True" ElementStyle="{StaticResource Celda.Derecha}" />
        <DataGridTemplateColumn Header="Observaciones" Width="1.4*" MinWidth="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                       IsReadOnly="{Binding Data.EsLectura, Source={StaticResource Proxy}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Acciones" Width="105">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="🗑 Quitar" Style="{StaticResource Boton.Enlace}" Foreground="{StaticResource Brush.Peligro}"
                      Visibility="{Binding Data.EsEditable, Source={StaticResource Proxy}, Converter={StaticResource BoolAVisibilidad}}"
                      Command="{Binding DataContext.QuitarAnimalCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding CantidadTexto}" FontSize="15" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,26,0" />
        <TextBlock Text="Valor a trasladar" FontSize="15" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,0" />
        <Border Style="{StaticResource Tarjeta}" Padding="14,5" MinWidth="150">
          <TextBlock Text="{Binding ValorTexto}" FontSize="16" FontWeight="Medium" Foreground="{StaticResource Brush.Primario}" HorizontalAlignment="Right" />
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="✎ EDITAR TRASLADO" Command="{Binding EditarTrasladoCommand}"
                Visibility="{Binding PuedeEditarODesechar, Converter={StaticResource BoolAVisibilidad}}" />
        <Button Margin="10,0,0,0" Content="⊘ ANULAR TRASLADO" Command="{Binding AnularCommand}" Style="{StaticResource Boton.Peligro}"
                Visibility="{Binding PuedeEditarODesechar, Converter={StaticResource BoolAVisibilidad}}" />
        <Button Margin="10,0,0,0" Content="{Binding TextoConfirmar}" Command="{Binding ConfirmarCommand}" Style="{StaticResource Boton.Primario}"
                Visibility="{Binding EsEditable, Converter={StaticResource BoolAVisibilidad}}" />
        <Button Margin="10,0,0,0" Content="CANCELAR" Command="{Binding CancelarCommand}" IsCancel="True" MinWidth="100"
                Visibility="{Binding EsEditable, Converter={StaticResource BoolAVisibilidad}}" />
        <Button Margin="10,0,0,0" Content="CERRAR" Command="{Binding CancelarCommand}" MinWidth="100"
                Visibility="{Binding EsEditable, Converter={StaticResource InvertirVisibilidad}}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
