<UserControl x:Class="UCaldas.Granjas.App.Vistas.ComprasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <TextBlock Text="Histórico de Compras" Style="{StaticResource Texto.Titulo}" VerticalAlignment="Center" Margin="0,0,28,0" />
      <ContentControl Content="{Binding Rango}" VerticalAlignment="Center" IsTabStop="False" />
    </StackPanel>

    <!-- Resumen -->
    <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,16,0,0" HorizontalAlignment="Left" Width="720">
      <Border Style="{StaticResource Tarjeta}" Margin="0,0,10,0" Padding="12,10">
        <StackPanel>
          <TextBlock Text="Total Compras" Style="{StaticResource Texto.KpiEtiqueta}" />
          <TextBlock Text="{Binding TotalCompras}" Style="{StaticResource Texto.KpiValor}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tarjeta}" Margin="0,0,10,0" Padding="12,10">
        <StackPanel>
          <TextBlock Text="Unidades Compradas" Style="{StaticResource Texto.KpiEtiqueta}" />
          <TextBlock Text="{Binding AnimalesComprados, StringFormat=N0}" Style="{StaticResource Texto.KpiValor}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Tarjeta}" Padding="12,10">
        <StackPanel>
          <TextBlock Text="Total Compras ($)" Style="{StaticResource Texto.KpiEtiqueta}" />
          <TextBlock Text="{Binding ValorTotalTexto}" Style="{StaticResource Texto.KpiValor}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Búsqueda -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,12">
      <TextBlock Text="Buscar por Factura" FontSize="15" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,10,0" />
      <Grid Width="230">
        <TextBox Text="{Binding TextoFactura, UpdateSourceTrigger=PropertyChanged}">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding BuscarCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <TextBlock Text="🔍 Número Factura" Style="{StaticResource Texto.Marcador}"
                   Visibility="{Binding TextoFactura, Converter={StaticResource NuloAVisibilidad}, ConverterParameter=invertir}" />
      </Grid>
      <Button Margin="10,0,0,0" Content="Buscar" Command="{Binding BuscarCommand}" MinWidth="90" />
      <CheckBox Margin="22,0,0,0" Content="Incluir anuladas" IsChecked="{Binding IncluirAnuladas}" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Tabla -->
    <DataGrid Grid.Row="3" ItemsSource="{Binding Compras}" SelectedItem="{Binding Seleccionada}">
      <DataGrid.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding VerDetalleCommand}" CommandParameter="{Binding Seleccionada}" />
      </DataGrid.InputBindings>
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Anulada}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Peligro}" />
              <Setter Property="ToolTip" Value="Compra anulada" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Factura" Binding="{Binding NumeroFactura}" Width="1*" MinWidth="82" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Orden" Binding="{Binding OrdenCompra, TargetNullValue='-'}" Width="1*" MinWidth="100" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy'}" Width="0.9*" MinWidth="88" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Entidad / Proveedor" Binding="{Binding Proveedor}" Width="1.6*" MinWidth="125" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Granja" Binding="{Binding GranjaDestino}" Width="0.9*" MinWidth="72" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Identificador" Binding="{Binding Identificador}" Width="1.2*" MinWidth="100" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Categoría / Etapa" Binding="{Binding CategoriaEtapa}" Width="1.3*" MinWidth="95" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, StringFormat='N0'}" Width="0.6*" MinWidth="52" ElementStyle="{StaticResource Celda.Centro}" />
        <DataGridTextColumn Header="Valor Unitario" Binding="{Binding ValorUnitario, StringFormat='$#,##0'}" Width="1.1*" MinWidth="96" ElementStyle="{StaticResource Celda.Derecha}" />
        <DataGridTextColumn Header="Total" Binding="{Binding TotalFactura, StringFormat='$#,##0'}" Width="1.1*" MinWidth="96" ElementStyle="{StaticResource Celda.Derecha}" />      </DataGrid.Columns>
    </DataGrid>

    <UniformGrid Grid.Row="4" Rows="1" Margin="0,14,0,0">
      <Button Margin="0,0,-1,0" Padding="10,11" Content="👁 VER DETALLE COMPRA" Command="{Binding VerDetalleCommand}" CommandParameter="{Binding Seleccionada}" />
      <Button Margin="0,0,-1,0" Padding="10,11" Content="+ NUEVA COMPRA" Command="{Binding NuevaCompraCommand}" />
      <Button Padding="10,11" Content="📊 GENERAR INFORME" Command="{Binding GenerarInformeCommand}" />
    </UniformGrid>
  </Grid>
</UserControl>
