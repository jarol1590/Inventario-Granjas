<Application x:Class="UCaldas.Granjas.PrototipoRemisiones.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="VentanaPrototipo.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Estilos/Colores.xaml" />
        <ResourceDictionary Source="Estilos/Controles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Tonos de apoyo del prototipo (derivados de la paleta institucional) para estados y avisos. -->
      <SolidColorBrush x:Key="Brush.AvisoFondo" Color="#FFF4DC" />
      <SolidColorBrush x:Key="Brush.InfoFondo" Color="#E3EEF6" />
      <SolidColorBrush x:Key="Brush.NeutroFondo" Color="#EEF1EF" />

      <!-- Celdas de las tablas del prototipo. -->
      <Style x:Key="Cel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
      <Style x:Key="CelNegrita" TargetType="TextBlock" BasedOn="{StaticResource Cel}">
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style x:Key="CelDerecha" TargetType="TextBlock" BasedOn="{StaticResource CelNegrita}">
        <Setter Property="HorizontalAlignment" Value="Right" />
      </Style>
      <Style x:Key="Encab" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style x:Key="Campo.Etiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextoSuave}" />
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>
      <Style x:Key="Etiqueta.Estado" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
