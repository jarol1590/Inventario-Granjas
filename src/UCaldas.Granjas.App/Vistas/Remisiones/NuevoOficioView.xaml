<UserControl x:Class="UCaldas.Granjas.App.Vistas.Remisiones.NuevoOficioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="26,20,26,22">
    <Border Background="{StaticResource Brush.InfoFondo}" BorderBrush="{StaticResource Brush.PrimarioClaro}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.Primario}" FontSize="12"
                 Text="ℹ️ Este oficio aplica únicamente a remisiones de VENTA del programa elegido. No se pueden mezclar productos o animales de otros programas. Puede cerrarse para no admitir más remisiones." />
    </Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TextBlock Text="*Número de oficio:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Margin="0,0,0,10" Text="{Binding NumeroOficio, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" FontWeight="Medium" />
      <TextBlock Grid.Row="1" Text="*Fecha del oficio:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" VerticalAlignment="Center" />
      <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Left" Width="160" SelectedDate="{Binding Fecha, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Grid.Row="2" Text="*Programa exclusivo:" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,10" VerticalAlignment="Center" />
      <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" ItemsSource="{Binding Programas}" SelectedItem="{Binding ProgramaSeleccionado}" DisplayMemberPath="Nombre"
                IsEnabled="{Binding PuedeCambiarPrograma}" ToolTip="Un oficio con remisiones ya no puede cambiar de programa." />
      <TextBlock Grid.Row="3" Text="Observaciones:" Style="{StaticResource Texto.Etiqueta}" VerticalAlignment="Top" Margin="0,6,0,0" />
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
               VerticalContentAlignment="Top" MaxLength="300" />
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="💾 GUARDAR OFICIO" Command="{Binding GuardarCommand}" Style="{StaticResource Boton.Primario}" IsDefault="True" Padding="16,9" />
      <Button Margin="10,0,0,0" Content="CANCELAR" Command="{Binding CancelarCommand}" IsCancel="True" Padding="14,9" />
    </StackPanel>
  </StackPanel>
</UserControl>
